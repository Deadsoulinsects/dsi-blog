---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site-config';

type Star = {
	id: number;
	left: number;
	top: number;
	size: number;
	opacity: number;
	duration: number;
	delay: number;
	blur: number;
	color: string;
	driftX: number;
	driftY: number;
};

const navItems = [
	{
		title: siteConfig.navigation.home.blog,
		href: '/blog',
		icon: 'book',
	},
	{
		title: siteConfig.navigation.home.projects,
		href: '/projects',
		icon: 'folder',
	},
	{
		title: siteConfig.navigation.home.docs,
		href: '/docs',
		icon: 'file',
	},
	{
		title: siteConfig.navigation.home.origin,
		href: '/origin',
		icon: 'info',
	},
	{
		title: siteConfig.navigation.home.about,
		href: '/about',
		icon: 'info',
	},
];

const base = import.meta.env.BASE_URL;

const withBase = (path: string) => {
	const trimmedBase = base.endsWith('/') ? base.slice(0, -1) : base;
	const normalizedPath = path.startsWith('/') ? path : `/${path}`;

	return `${trimmedBase}${normalizedPath}`;
};

const createSeededRandom = (seed: number) => {
	let value = seed;

	return () => {
		value = (value * 9301 + 49297) % 233280;
		return value / 233280;
	};
};

const buildStars = (): Star[] => {
	const random = createSeededRandom(20260517);
	const count = 160;
	const colorPalette = [
		'rgba(255, 255, 255, 0.94)',
		'rgba(226, 232, 240, 0.92)',
		'rgba(186, 230, 253, 0.96)',
		'rgba(191, 219, 254, 0.94)',
	];

	return Array.from({ length: count }, (_, id) => {
		const sizeSeed = random();
		const opacitySeed = random();
		const durationSeed = random();
		const delaySeed = random();
		const blurSeed = random();
		const colorSeed = random();
		const size = 1.4 + sizeSeed * 3.4;
		const opacity = 0.32 + opacitySeed * 0.58;
		const duration = 2.6 + durationSeed * 4.2;
		const delay = delaySeed * -8;
		const blur = size > 3 ? 0.8 + blurSeed * 1.8 : blurSeed * 0.8;
		const color = colorPalette[Math.floor(colorSeed * colorPalette.length)];

		return {
			id,
			left: random() * 100,
			top: random() * 100,
			size,
			opacity,
			duration,
			delay,
			blur,
			color,
			driftX: (random() - 0.5) * 12,
			driftY: (random() - 0.5) * 12,
		};
	});
};

const stars = buildStars();
---

<Layout title={siteConfig.site.name} description={siteConfig.home.metaDescription} hideChrome={true} fullBleed={true}>
	<section class="cover-frame" aria-labelledby="cover-title">
		<div class="cover-ambient" aria-hidden="true"></div>

		<div class="starfield" aria-hidden="true">
			{
				stars.map((star) => (
					<span
						class="star"
						style={`
							--star-x: ${star.left}%;
							--star-y: ${star.top}%;
							--star-size: ${star.size}px;
							--star-opacity: ${star.opacity};
							--star-duration: ${star.duration}s;
							--star-float-duration: ${Math.max(10, star.duration * 2.2)}s;
							--star-delay: ${star.delay}s;
							--star-blur: ${star.blur}px;
							--star-color: ${star.color};
							--star-drift-x: ${star.driftX}px;
							--star-drift-y: ${star.driftY}px;
							--star-shine: ${Math.max(5, star.size * 4)}px;
						`}
					></span>
				))
			}
		</div>

		<div class="cover-content">
			<p class="cover-kicker">{siteConfig.home.kicker}</p>

			<h1 id="cover-title" class="cover-title">{siteConfig.site.name}</h1>

			<p class="cover-subtitle">{siteConfig.home.subtitle}</p>

			<p class="cover-description">{siteConfig.home.description}</p>

			<nav class="cover-nav" aria-label="首页主要入口">
				{
					navItems.map((item) => (
						<a class="cover-link" href={withBase(item.href)}>
							<span class="cover-icon" aria-hidden="true">
								{item.icon === 'book' && (
									<svg viewBox="0 0 24 24" focusable="false">
										<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H11v16H6.5A2.5 2.5 0 0 0 4 21.5v-16Z" />
										<path d="M13 3h4.5A2.5 2.5 0 0 1 20 5.5v16a2.5 2.5 0 0 0-2.5-2.5H13V3Z" />
									</svg>
								)}
								{item.icon === 'folder' && (
									<svg viewBox="0 0 24 24" focusable="false">
										<path d="M3.5 6.5A2.5 2.5 0 0 1 6 4h4.2l1.8 2.2h6A2.5 2.5 0 0 1 20.5 8.7v8.8A2.5 2.5 0 0 1 18 20H6a2.5 2.5 0 0 1-2.5-2.5v-11Z" />
										<path d="M7.5 10h9" />
									</svg>
								)}
								{item.icon === 'file' && (
									<svg viewBox="0 0 24 24" focusable="false">
										<path d="M6 3.5h7l5 5V20a.5.5 0 0 1-.5.5h-11A.5.5 0 0 1 6 20V3.5Z" />
										<path d="M13 3.5V9h5" />
										<path d="M9 13h6" />
										<path d="M9 16.5h5" />
									</svg>
								)}
								{item.icon === 'info' && (
									<svg viewBox="0 0 24 24" focusable="false">
										<circle cx="12" cy="12" r="8.5" />
										<path d="M12 11.5v5" />
										<path d="M12 7.5h.01" />
									</svg>
								)}
							</span>
							<span>{item.title}</span>
						</a>
					))
				}
			</nav>
		</div>

		<div class="cover-motto" aria-label="站点标语">
			<p>{siteConfig.home.englishMotto}</p>
			<p>{siteConfig.home.chineseMotto}</p>
		</div>
	</section>
</Layout>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		min-height: 100%;
		overflow-x: hidden;
		background: #02040c;
	}

	.cover-frame {
		--fog-core: 0.16;
		--fog-cyan: 0.09;
		--left-violet: 0.27;
		--right-blue: 0.24;
		--starfield-opacity: 1;
		--star-size-scale: 1.8;
		--twinkle-low: 0.35;
		--twinkle-mid: 0.78;
		--twinkle-peak: 1.5;
		--drift-scale: 2;
		--vignette: 0.34;
		--content-y: -8vh;
		--title-vw: 10vw;
		--title-size: clamp(4.25rem, var(--title-vw), 9.4rem);
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		box-sizing: border-box;
		width: 100vw;
		height: 100svh;
		min-height: 100svh;
		margin: 0;
		padding: clamp(38px, 5vw, 76px) clamp(22px, 5vw, 72px) clamp(86px, 8vw, 116px);
		overflow: hidden;
		text-align: center;
		background:
			radial-gradient(circle at 50% 16%, rgba(220, 235, 250, 0.045), transparent 32%),
			linear-gradient(180deg, rgba(12, 17, 33, 0.42), rgba(2, 4, 12, 0.82)),
			#02040c;
	}

	.cover-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -10;
		pointer-events: none;
		background:
			radial-gradient(ellipse at center, transparent 0%, transparent 38%, rgba(0, 0, 0, var(--vignette)) 100%),
			linear-gradient(90deg, rgba(0, 0, 0, 0.22), transparent 24%, transparent 76%, rgba(0, 0, 0, 0.24));
	}

	.cover-ambient {
		position: absolute;
		inset: 0;
		z-index: -30;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse at 50% 36%,
				rgba(210, 226, 245, var(--fog-core)) 0%,
				rgba(56, 189, 248, var(--fog-cyan)) 20%,
				rgba(15, 23, 42, 0.18) 44%,
				transparent 70%
			),
			radial-gradient(circle at 14% 10%, rgba(124, 58, 237, var(--left-violet)), transparent 36%),
			radial-gradient(circle at 86% 18%, rgba(56, 189, 248, var(--right-blue)), transparent 38%),
			radial-gradient(ellipse at 50% 92%, rgba(49, 46, 129, 0.16), transparent 44%),
			linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(3, 7, 18, 0.9) 62%, rgba(2, 4, 12, 1) 100%);
	}

	.cover-ambient::before,
	.cover-ambient::after {
		content: '';
		position: absolute;
		border-radius: 999px;
		pointer-events: none;
		filter: blur(78px);
	}

	.cover-ambient::before {
		inset: 16% 22% 34%;
		background: rgba(115, 135, 190, 0.17);
		opacity: 0.7;
	}

	.cover-ambient::after {
		top: 24%;
		left: 50%;
		width: min(48vw, 760px);
		height: min(34vw, 500px);
		background: rgba(125, 211, 252, 0.11);
		opacity: 0.58;
		transform: translateX(-50%);
	}

	.starfield {
		position: absolute;
		inset: 0;
		z-index: -20;
		pointer-events: none;
		overflow: hidden;
		opacity: var(--starfield-opacity);
	}

	.star {
		position: absolute;
		left: var(--star-x);
		top: var(--star-y);
		width: calc(var(--star-size) * var(--star-size-scale));
		height: calc(var(--star-size) * var(--star-size-scale));
		animation: floatStar var(--star-float-duration) ease-in-out var(--star-delay) infinite;
	}

	.star::before {
		content: '';
		position: absolute;
		inset: 0;
		display: block;
		border-radius: 999px;
		background: var(--star-color);
		opacity: var(--star-opacity);
		filter: blur(var(--star-blur));
		box-shadow: 0 0 var(--star-shine) var(--star-color);
		animation: twinkleStar var(--star-duration) ease-in-out var(--star-delay) infinite;
	}

	.cover-content,
	.cover-motto {
		position: relative;
		z-index: 2;
	}

	@keyframes twinkleStar {
		0% {
			transform: scale(0.85);
			opacity: calc(var(--star-opacity) * var(--twinkle-low));
		}

		100% {
			transform: scale(0.85);
			opacity: calc(var(--star-opacity) * var(--twinkle-low));
		}

		35% {
			transform: scale(1);
			opacity: calc(var(--star-opacity) * var(--twinkle-mid));
		}

		62% {
			transform: scale(1.25);
			opacity: calc(var(--star-opacity) * var(--twinkle-peak));
		}
	}

	@keyframes floatStar {
		0% {
			transform: translate3d(0, 0, 0);
		}

		100% {
			transform: translate3d(0, 0, 0);
		}

		50% {
			transform: translate3d(calc(var(--star-drift-x) * var(--drift-scale)), calc(var(--star-drift-y) * var(--drift-scale)), 0);
		}
	}

	.cover-content {
		width: min(100%, 1200px);
		min-width: 0;
		transform: translateY(var(--content-y));
	}

	.cover-kicker {
		margin: 0;
		font-family: var(--font-meta);
		font-size: clamp(0.7rem, 1vw, 0.82rem);
		font-weight: 400;
		line-height: 1.6;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.cover-title {
		max-width: min(1200px, 100%);
		margin: clamp(20px, 2.2vw, 30px) auto 0;
		font-size: var(--title-size);
		font-family: var(--font-brand);
		font-weight: 400;
		line-height: 0.88;
		letter-spacing: -0.025em;
		color: #f8fafc;
		text-wrap: balance;
		text-shadow: 0 0 38px rgba(186, 230, 253, 0.12);
	}

	.cover-subtitle {
		max-width: 30em;
		margin: clamp(28px, 3vw, 40px) auto 0;
		font-size: clamp(1.35rem, 2.3vw, 2.1rem);
		font-family: var(--font-display);
		font-weight: 500;
		line-height: 1.45;
		letter-spacing: -0.025em;
		color: #edf2ff;
		text-wrap: balance;
	}

	.cover-description {
		max-width: 680px;
		margin: 14px auto 0;
		font-family: var(--font-ui);
		font-size: clamp(0.86rem, 1.2vw, 1rem);
		line-height: 1.75;
		color: var(--text-soft);
		text-wrap: balance;
	}

	.cover-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		margin-top: 32px;
	}

	.cover-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 10px 17px;
		border: 1px solid rgba(148, 163, 184, 0.2);
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.48);
		color: #e2e8f0;
		text-decoration: none;
		backdrop-filter: blur(14px);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.045);
		transition:
			transform 0.22s ease,
			border-color 0.22s ease,
			background 0.22s ease,
			color 0.22s ease;
	}

	.cover-icon {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		color: rgba(125, 211, 252, 0.88);
	}

	.cover-icon svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.9;
		stroke-linecap: round;
		stroke-linejoin: round;
		filter: drop-shadow(0 0 5px rgba(125, 211, 252, 0.12));
	}

	.cover-link span {
		font-size: 0.9rem;
		font-weight: 700;
	}

	.cover-link:hover,
	.cover-link:focus-visible {
		color: #e0f2fe;
		border-color: rgba(125, 211, 252, 0.4);
		background: rgba(45, 63, 99, 0.52);
		transform: translateY(-2px);
	}

	.cover-link:focus-visible {
		outline: 2px solid rgba(125, 211, 252, 0.86);
		outline-offset: 4px;
	}

	.cover-motto {
		position: absolute;
		right: 24px;
		bottom: 88px;
		left: 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 7px;
		color: rgba(100, 116, 139, 0.82);
		pointer-events: none;
	}

	.cover-motto p {
		margin: 0;
		font-size: clamp(0.64rem, 0.9vw, 0.74rem);
		line-height: 1.3;
		letter-spacing: 0.32em;
		text-transform: uppercase;
	}

	.cover-motto p:last-child {
		font-size: clamp(0.62rem, 0.85vw, 0.72rem);
		letter-spacing: 0.2em;
		text-transform: none;
		color: rgba(71, 85, 105, 0.78);
	}

	@media (max-height: 760px) and (min-width: 821px) {
		.cover-frame {
			--content-y: -2vh;
			padding: 34px clamp(22px, 5vw, 72px) 78px;
		}

		.cover-title {
			font-size: clamp(3.4rem, 8.6vw, 7.2rem);
		}
	}

	@media (max-height: 620px) and (min-width: 821px) {
		.cover-frame {
			height: auto;
			grid-template-rows: 1fr auto;
			padding-block: 32px;
			row-gap: 38px;
		}

		.cover-content {
			transform: none;
		}

		.cover-motto {
			position: static;
		}
	}

	@media (max-width: 820px) {
		.cover-frame {
			--starfield-opacity: 0.72;
			height: auto;
			padding: 42px 18px 96px;
			overflow: visible;
		}

		.cover-content {
			transform: none;
		}

		.cover-motto {
			position: static;
			margin-top: 28px;
		}

		.star:nth-child(n + 111) {
			display: none;
		}

		.cover-title {
			font-size: clamp(3.25rem, 15.4vw, 5.6rem);
			line-height: 0.9;
			letter-spacing: -0.075em;
		}

		.cover-subtitle {
			max-width: 19em;
			font-size: clamp(1.2rem, 4.2vw, 1.75rem);
		}

		.cover-description {
			max-width: 23em;
			font-size: 0.85rem;
		}
	}

	@media (max-width: 430px) {
		.star:nth-child(n + 81) {
			display: none;
		}

		.cover-frame {
			--starfield-opacity: 0.66;
			padding-top: 34px;
			padding-bottom: 48px;
		}

		.cover-title {
			font-size: clamp(2.9rem, 14.8vw, 4.1rem);
			letter-spacing: -0.06em;
		}

		.cover-nav {
			max-width: 260px;
			margin-right: auto;
			margin-left: auto;
		}

		.cover-link {
			justify-content: center;
			min-width: 92px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.star,
		.star::before {
			animation: none;
		}
	}
</style>
