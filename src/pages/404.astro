---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';

const base = import.meta.env.BASE_URL;
---

<Layout title="404 | Dead Soul Insects" description="页面未找到。返回首页或查看文章列表。" canonicalPath="/404.html">
	<section class="not-found" aria-labelledby="not-found-title">
		<p class="status-code">404</p>
		<h1 id="not-found-title">页面未找到</h1>
		<p class="not-found-message">这个地址没有对应的页面。你可以返回首页，或前往文章列表。</p>
		<nav class="not-found-actions" aria-label="页面恢复操作">
			<a class="home-link" href={withBase(base, '/')}>返回首页</a>
			<a href={withBase(base, '/blog/')}>返回文章</a>
		</nav>
	</section>
</Layout>

<style>
	.not-found {
		max-inline-size: var(--reading-measure);
		margin-inline: auto;
		padding-block: var(--space-7) var(--space-5);
		overflow-wrap: anywhere;
		text-align: center;
	}

	.status-code {
		margin: 0 0 var(--space-3);
		color: var(--accent-soft);
		font-family: var(--font-meta);
		font-size: var(--text-note);
		line-height: 1.6;
	}

	h1 {
		margin: 0 0 var(--space-5);
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 500;
		line-height: 1.3;
	}

	.not-found-message {
		margin: 0;
		color: var(--text-soft);
		font-size: var(--text-body);
		line-height: 1.8;
	}

	.not-found-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-3) var(--space-6);
		margin-top: var(--space-6);
	}

	.not-found-actions a {
		display: inline-flex;
		align-items: center;
		max-inline-size: 100%;
		min-block-size: 2.75rem;
		padding-block: var(--space-2);
		color: var(--accent-soft);
		line-height: 1.6;
		text-decoration: underline;
		text-underline-offset: var(--space-1);
	}

	.not-found-actions .home-link {
		color: var(--text);
		font-weight: 600;
	}

	.not-found-actions a:is(:hover, :focus-visible) {
		color: var(--text);
	}
</style>
