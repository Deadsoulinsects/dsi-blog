---
import Layout from '../layouts/Layout.astro';

const aboutSections = [
	{
		title: '这个站是做什么的',
		description:
			'Dead Soul Insects 用来收纳博客、项目入口和整理后的说明页。不求面面俱到，只保留愿意长期留下的内容。',
	},
	{
		title: '主要内容方向',
		description:
			'目前主要写建站记录、AI 工具实践，以及一些还在继续完善的项目和想法。',
	},
	{
		title: '这一页为什么存在',
		description:
			'这一页只补充必要的信息：这里是谁在写、内容大致覆盖什么、如果需要该怎样联系。',
	},
] as const;

const contacts = [
	{
		label: '邮箱',
		value: '3178381848@qq.com',
		copyValue: '3178381848@qq.com',
	},
	{
		label: 'QQ',
		value: '3178381848',
		copyValue: '3178381848',
	},
	{
		label: '微信',
		value: 'ky3178381848',
		copyValue: 'ky3178381848',
	},
] as const;
---

<Layout title="关于 | Dead Soul Insects" description="Dead Soul Insects 的简要站点介绍与写作方向说明。" canonicalPath="/about/">
	<div class="editorial-page about-page">
		<section class="intro intro--single">
			<div class="intro-grid">
				<div class="intro-copy">
					<p class="kicker">关于</p>
					<h1>简要说明<span class="heading-unit">这个站</span>和写它的人</h1>
					<p class="lead">这里不放完整履历，只把站点用途、写作方向和联系方式说明白。</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="about-title">
			<header class="section-heading">
				<span class="section-index">01 / ABOUT</span>
				<div class="section-copy">
					<p class="kicker">说明</p>
					<h2 id="about-title">把必要的信息留在这里</h2>
					<p class="section-note">更多内容会回到博客、项目和文档里展开，这里只保留最必要的说明。</p>
				</div>
			</header>

			<div class="editorial-stack">
				{aboutSections.map((section, index) => (
					<article class="editorial-row">
						<span class="editorial-row-index">{String(index + 1).padStart(2, '0')}</span>
						<div>
							<h3>{section.title}</h3>
							<p>{section.description}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="section" aria-labelledby="contact-title">
			<header class="section-heading">
				<span class="section-index">02 / CONTACT</span>
				<div class="section-copy">
					<p class="kicker">CONTACT</p>
					<h2 id="contact-title">联系方式</h2>
				</div>
			</header>

			<ul class="contact-list">
				{contacts.map((contact) => (
					<li class="contact-row">
						<span class="contact-label">{contact.label}</span>
						<span class="contact-value">{contact.value}</span>
						<button class="copy-btn" type="button" data-copy-value={contact.copyValue}>
							<span data-copy-label aria-live="polite">复制</span>
						</button>
					</li>
				))}
			</ul>
		</section>
	</div>
</Layout>

<script>
	const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-btn');

	copyButtons.forEach((button) => {
		let resetTimer: number | undefined;

		button.addEventListener('click', async () => {
			const copyValue = button.dataset.copyValue;
			const label = button.querySelector<HTMLSpanElement>('[data-copy-label]');
			const clipboard = navigator.clipboard;

			if (!copyValue || !label || !clipboard) {
				return;
			}

			try {
				await clipboard.writeText(copyValue);
			} catch {
				return;
			}

			window.clearTimeout(resetTimer);
			label.textContent = '已复制';
			button.classList.add('copied');

			resetTimer = window.setTimeout(() => {
				label.textContent = '复制';
				button.classList.remove('copied');
			}, 1200);
		});
	});
</script>

<style>
	.heading-unit {
		white-space: nowrap;
	}

	.contact-list {
		padding: 0;
		list-style: none;
		border-top: var(--rule-strong) solid var(--text);
	}

	.contact-row {
		display: grid;
		grid-template-columns: var(--column-contact-label) minmax(0, 1fr) var(--column-contact-action);
		gap: var(--space-5);
		align-items: center;
		padding: var(--space-4) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.contact-label {
		color: var(--accent-soft);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-meta);
	}

	.contact-value {
		min-width: 0;
		color: var(--text);
		overflow-wrap: anywhere;
	}

	.copy-btn {
		justify-self: end;
		padding: var(--space-2) var(--space-3);
		border: var(--rule-thin) solid var(--line);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--text-soft);
		font-size: 0.76rem;
		cursor: pointer;
		transition:
			border-color var(--duration-fast) ease,
			background var(--duration-fast) ease,
			color var(--duration-fast) ease;
	}

	.copy-btn:is(:hover, :focus-visible, .copied) {
		border-color: color-mix(in srgb, var(--accent-soft) 28%, var(--line));
		background: color-mix(in srgb, var(--accent-soft) 8%, transparent);
		color: var(--text);
	}

	@media (max-width: 760px) {
		.contact-row {
			grid-template-columns: 5rem minmax(0, 1fr);
			gap: var(--space-3);
		}

		.copy-btn {
			grid-column: 2;
			justify-self: start;
		}
	}
</style>
