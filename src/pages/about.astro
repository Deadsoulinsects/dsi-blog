---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/site-config';

const writingDirection = siteConfig.about.overview.sections.find((section) => section.title === '主要内容方向');
const contacts = siteConfig.about.contact.items;
---

<Layout
	title={`关于 | ${siteConfig.site.name}`}
	description={siteConfig.about.metaDescription}
	canonicalPath="/about/"
	mainId="about-main"
	skipLinkLabel="跳到关于内容"
>
	<div class="about-page">
		<h1>关于</h1>
		<div class="about-copy">
			<p>{siteConfig.site.name} 是一个个人博客，收纳博客文章、项目入口和整理后的说明页。</p>
			{writingDirection && <p>{writingDirection.description}</p>}
		</div>

		<section class="about-contact" aria-labelledby="contact-title">
			<h2 id="contact-title">{siteConfig.about.contact.heading}</h2>
			<ul class="contact-list">
				{contacts.map((contact) => (
					<li class="contact-row">
						<div class="contact-detail">
							<span class="contact-label">{contact.label}</span>
							<span class="contact-value">{contact.value}</span>
						</div>
						<button
							class="copy-btn"
							type="button"
							data-copy-value={contact.copyValue}
							data-contact-label={contact.label}
							aria-label={`复制${contact.label}`}
						>
							复制
						</button>
					</li>
				))}
			</ul>
		</section>
	</div>
	<div class="copy-toast" role="status" aria-live="polite" aria-atomic="true"></div>
</Layout>

<script>
	const copyButtons = document.querySelectorAll<HTMLButtonElement>('.copy-btn');
	const toast = document.querySelector<HTMLElement>('.copy-toast');

	if (toast) {
		let toastTimer: number | undefined;
		const showToast = (message: string, duration = 4000) => {
			window.clearTimeout(toastTimer);
			toast.textContent = message;
			toast.classList.add('is-visible');
			toastTimer = window.setTimeout(() => {
				toast.classList.remove('is-visible');
				toast.textContent = '';
			}, duration);
		};

		copyButtons.forEach((button) => {
			button.addEventListener('click', async () => {
				const copyValue = button.dataset.copyValue;
				const contactLabel = button.dataset.contactLabel;
				const clipboard = navigator.clipboard;

				if (!copyValue || !contactLabel) {
					return;
				}

				if (!clipboard) {
					showToast(`${contactLabel}无法自动复制，请手动复制。`, 6000);
					return;
				}

				button.disabled = true;
				button.textContent = '复制中';

				try {
					await clipboard.writeText(copyValue);
					showToast(`${contactLabel}已复制。`);
				} catch {
					showToast(`${contactLabel}复制失败，请手动复制或重试。`, 6000);
				} finally {
					button.disabled = false;
					button.textContent = '复制';
				}
			});
		});
	}
</script>

<style>
	.about-page {
		margin-inline: auto;
		padding-block-start: var(--space-7);
		overflow-wrap: anywhere;
	}

	h1 {
		margin: 0 0 var(--space-6);
		font-family: var(--font-reading);
		font-size: var(--text-section);
		font-weight: 500;
		line-height: 1.3;
	}

	.about-copy p {
		margin: 0;
		font-size: var(--text-body);
		line-height: 1.85;
	}

	.about-copy p + p {
		margin-block-start: var(--space-4);
		color: var(--text-soft);
	}

	.about-contact {
		margin-block-start: var(--space-7);
	}

	h2 {
		margin: 0 0 var(--space-3);
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.6;
	}

	.contact-list {
		container-type: inline-size;
		margin: 0;
		padding: 0;
		list-style: none;
		border-block-start: var(--rule-thin) solid var(--line);
	}

	.contact-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		column-gap: var(--space-4);
		align-items: center;
		padding: var(--space-5) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.contact-detail {
		min-inline-size: 0;
	}

	.contact-label {
		display: block;
		margin-block-end: var(--space-1);
		color: var(--text-soft);
		font-size: var(--text-note);
		line-height: 1.6;
	}

	.contact-value {
		color: var(--text);
		font-size: var(--text-body);
		line-height: 1.75;
		overflow-wrap: anywhere;
		user-select: text;
	}

	.copy-toast {
		position: fixed;
		z-index: 150;
		inset-block-end: var(--space-4);
		inset-inline-start: 50%;
		inline-size: max-content;
		max-inline-size: min(calc(100% - var(--space-6)), var(--intro-measure));
		padding: var(--space-3) var(--space-4);
		border: var(--rule-thin) solid var(--line);
		border-radius: var(--space-3);
		background: var(--panel-strong);
		color: var(--text);
		font-size: var(--text-note);
		line-height: 1.75;
		overflow-wrap: anywhere;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, var(--space-2));
		transition:
			opacity var(--duration-fast) ease,
			transform var(--duration-fast) var(--ease-standard);
	}

	.copy-toast.is-visible {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.copy-btn {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		justify-self: end;
		min-block-size: 2.75rem;
		padding: var(--space-2) var(--space-4);
		border: var(--rule-thin) solid var(--line);
		border-radius: var(--radius-pill);
		background: transparent;
		color: var(--text-soft);
		font-size: var(--text-note);
		white-space: nowrap;
		cursor: pointer;
		transition:
			border-color var(--duration-fast) ease,
			background var(--duration-fast) ease,
			color var(--duration-fast) ease;
	}

	.copy-btn::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		inline-size: 100%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: color-mix(in srgb, var(--accent-soft) 8%, transparent);
		pointer-events: none;
		transform: translate(-50%, -50%) scale(0);
		transition: transform calc(var(--duration-slider) * 2.5) ease-in-out;
	}

	.copy-btn:not(:disabled):is(:hover, :focus-visible)::before {
		transform: translate(-50%, -50%) scale(1.5);
	}

	.copy-btn:is(:hover, :focus-visible) {
		border-color: color-mix(in srgb, var(--accent-soft) 28%, var(--line));
		background: color-mix(in srgb, var(--accent-soft) 8%, transparent);
		color: var(--text);
	}

	.copy-btn:disabled {
		cursor: progress;
	}

	@container (max-width: 18rem) {
		.contact-row {
			grid-template-columns: minmax(0, 1fr);
		}

		.copy-btn {
			justify-self: start;
			margin-block-start: var(--space-3);
		}
	}

	@media (max-width: 760px) {
		.about-page {
			padding-block-start: var(--space-6);
		}

		.copy-toast {
			inset-block-start: calc(var(--space-8) * 2);
			inset-block-end: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.copy-btn::before {
			transition: none;
		}
	}
</style>
