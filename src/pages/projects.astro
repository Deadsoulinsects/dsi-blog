---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';

type ProjectStatus = '已完成' | '进行中' | '实验' | '暂停';

interface ProjectLink {
	readonly label: string;
	readonly href: string;
	readonly external?: boolean;
}

interface ProjectItem {
	readonly name: string;
	readonly purpose: string;
	readonly status: ProjectStatus;
	readonly type: string;
	readonly links?: readonly ProjectLink[];
}

const projects: readonly ProjectItem[] = [
	{
		name: 'Dead Soul Insects 站点',
		purpose: '把博客、项目记录、说明文档与起源页收进同一个 Astro 静态站点里，作为长期维护中的公开入口。',
		status: '进行中',
		type: '站点项目',
		links: [
			{ label: '打开首页', href: '/' },
			{ label: '查看使用说明', href: '/docs/intro/' },
		],
	},
	{
		name: '项目页档案化改造',
		purpose: '把原本偏说明性的项目页改成真实条目入口，并验证更紧凑的档案式浏览是否适合后续维护。',
		status: '实验',
		type: '站点项目',
	},
	{
		name: 'Obsidian 到博客内容流',
		purpose: '先在本地笔记里沉淀原始记录，再整理成适合公开的博客内容，减少把私人工作区直接搬上站点。',
		status: '进行中',
		type: '自动化脚本',
		links: [{ label: '查看 Obsidian 专题', href: '/blog/topics/obsidian/' }],
	},
	{
		name: '内容准备与构建检查脚本',
		purpose: '在发布前补齐内容准备、链接检查与纯构建验证，尽量把高风险步骤留在正式发布之前。',
		status: '已完成',
		type: '自动化脚本',
		links: [
			{ label: '文档入口', href: '/docs/' },
			{ label: '使用说明', href: '/docs/intro/' },
		],
	},
	{
		name: 'SBTI 2.0',
		purpose: '围绕人格测试、结果页表现、BGM 氛围和部署上线做出来的 AI 小型网页实践。',
		status: '已完成',
		type: 'AI 项目',
		links: [
			{ label: '查看 SBTI 专题', href: '/blog/topics/sbti/' },
			{ label: '项目站点', href: 'https://sbti2.deadsoulinsects.cn', external: true },
		],
	},
];

const typeDescriptions = {
	站点项目: '围绕站点本体、页面入口和公开结构的持续维护。',
	自动化脚本: '服务于内容准备、同步与构建检查的实际流程工具。',
	'AI 项目': '已经做出可演示结果，或已经留下阶段记录的 AI 实践。',
} as const;

const typeOrder = ['站点项目', '自动化脚本', 'AI 项目'] as const;
const statusOrder = ['已完成', '进行中', '实验', '暂停'] as const satisfies readonly ProjectStatus[];
const statusClassMap = {
	已完成: 'done',
	进行中: 'active',
	实验: 'experimental',
	暂停: 'paused',
} as const satisfies Record<ProjectStatus, string>;

const groupedProjects = typeOrder
	.map((type) => ({
		type,
		description: typeDescriptions[type],
		items: projects.filter((project) => project.type === type),
	}))
	.filter((group) => group.items.length > 0);

const statusSummary = statusOrder
	.map((status) => ({
		status,
		count: projects.filter((project) => project.status === status).length,
	}))
	.filter((item) => item.count > 0)
	.map((item) => `${item.status} ${item.count}`)
	.join('、');

const base = import.meta.env.BASE_URL;
---

<Layout
	title="项目 | Dead Soul Insects"
	description="Dead Soul Insects 的真实项目入口页，按类型整理站点项目、自动化脚本与 AI 实践。"
	canonicalPath="/projects/"
>
	<div class="editorial-page projects-page">
		<section class="intro">
			<div class="intro-grid">
				<div>
					<p class="kicker">项目</p>
					<h1>只把真实做过的<span class="heading-unit">项目</span>，压成清楚入口</h1>
				</div>

				<div class="intro-side">
					<p class="lead">
						这一页现在只整理已经有依据的项目条目：要么已经做出来，要么正在维护，要么至少已经留下了可继续追踪的实验记录。状态说明成熟度，类型负责说明它属于哪一类实践。
					</p>

					<div class="intro-index" aria-label="项目概览">
						<div class="intro-stat">
							<span>项目条目</span>
							<strong>{projects.length}</strong>
						</div>
						<div class="intro-stat">
							<span>类型分区</span>
							<strong>{groupedProjects.length}</strong>
						</div>
					</div>

					<p class="intro-note">当前收录的项目以 {statusSummary} 为主，先按类型缩小范围，会比把所有项目一次摊平更适合继续维护和回看。</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="project-types-title">
			<header class="section-heading">
				<span class="section-index">01 / TYPES</span>
				<div class="section-copy">
					<p class="kicker">类型</p>
					<h2 id="project-types-title">先按实践类别进入</h2>
					<p class="section-note">保留类型说明、状态分布和真实条目，先判断属于哪一类实践，再继续进入相关页面或专题。</p>
				</div>
			</header>

			<div class="project-groups">
				{groupedProjects.map((group) => (
					<section class="project-group" aria-labelledby={`project-type-${group.type}`}>
						<header class="project-group-head">
							<p class="type-label">PROJECT TYPE · {String(group.items.length).padStart(2, '0')}</p>
							<h3 id={`project-type-${group.type}`}>{group.type}</h3>
							<p class="project-group-description">{group.description}</p>
						</header>

						<div class="project-list">
							{group.items.map((project) => (
								<article class="project-row">
									<div>
										<h4 class="project-name">{project.name}</h4>
										<p class="project-purpose">{project.purpose}</p>
										{project.links && (
											<div class="project-links">
												{project.links.map((link) => (
													<a
														href={link.external ? link.href : withBase(base, link.href)}
														target={link.external ? '_blank' : undefined}
														rel={link.external ? 'noreferrer' : undefined}
													>
														{link.label}
													</a>
												))}
											</div>
										)}
									</div>
									<span class:list={['status', statusClassMap[project.status]]}>{project.status}</span>
								</article>
							))}
						</div>
					</section>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.heading-unit {
		white-space: nowrap;
	}

	.project-groups {
		display: grid;
		gap: var(--space-7);
	}

	.project-group {
		display: grid;
		grid-template-columns: var(--column-project-aside) minmax(0, 1fr);
		gap: var(--space-6);
		min-width: 0;
	}

	.project-group-head {
		align-self: start;
		min-width: 0;
	}

	.type-label {
		color: var(--accent-soft);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-meta);
	}

	.project-group h3 {
		margin-top: var(--space-2);
		font-family: var(--font-reading);
		font-size: var(--text-row);
		font-weight: 500;
		line-height: 1.18;
	}

	.project-group-description {
		margin-top: var(--space-3);
		color: var(--text-soft);
		font-size: var(--text-note);
		line-height: 1.65;
	}

	.project-list {
		min-width: 0;
		border-top: var(--rule-strong) solid var(--text);
	}

	.project-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--column-project-status);
		gap: var(--space-5);
		padding: var(--space-5) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.project-row > div {
		min-width: 0;
	}

	.project-name {
		font-family: var(--font-reading);
		font-size: var(--text-row);
		font-weight: 500;
		line-height: 1.18;
	}

	.project-purpose {
		max-width: var(--list-measure);
		margin-top: var(--space-2);
		color: var(--text-soft);
		line-height: 1.68;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-3);
	}

	.project-links a {
		color: var(--accent-soft);
		font-size: var(--text-small);
		text-decoration: none;
	}

	.project-links a:is(:hover, :focus-visible) {
		text-decoration: underline;
		text-underline-offset: var(--space-1);
	}

	.status {
		justify-self: end;
		color: var(--text-soft);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-date);
	}

	.status.done {
		color: var(--accent-soft);
	}

	.status.active {
		color: var(--text);
	}

	@media (max-width: 760px) {
		.project-group {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3);
		}

		.project-groups {
			gap: var(--space-8);
		}
	}

	@media (max-width: 460px) {
		.project-row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3);
		}

		.status {
			justify-self: start;
		}
	}
</style>
