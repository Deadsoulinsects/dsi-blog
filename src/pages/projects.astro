---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';

type ProjectStatus = '已完成' | '进行中' | '实验' | '暂停';

interface ProjectLink {
	readonly label: string;
	readonly href: string;
	readonly external?: boolean;
}

interface ProjectItem {
	readonly name: string;
	readonly purpose: string;
	readonly status: ProjectStatus;
	readonly type: string;
	readonly links?: readonly ProjectLink[];
}

const projects: readonly ProjectItem[] = [
	{
		name: '项目页档案化改造',
		purpose: '把原本偏说明性的项目页改成真实条目入口，并验证更紧凑的档案式浏览是否适合后续维护。',
		status: '实验',
		type: '站点项目',
	},
	{
		name: '站点内容发布流程',
		purpose: '把私有 Obsidian 工作区中明确可发布的正文同步进站点，再在发布前补齐内容元数据并规范站内 Markdown 链接。',
		status: '进行中',
		type: '自动化脚本',
		links: [{ label: '进入项目专题', href: '/projects/topics/content-publishing/' }],
	},
	{
		name: 'SBTI 2.0',
		purpose: '围绕人格测试、结果页表现、BGM 氛围和部署上线完成的 AI 小型网页实践。',
		status: '已完成',
		type: 'AI 项目',
		links: [
			{ label: '打开项目', href: 'https://sbti2.deadsoulinsects.cn', external: true },
			{ label: '阅读项目记录', href: '/blog/topics/sbti-20/' },
		],
	},
];

const projectTypes = [
	{ name: '站点项目', id: 'site-projects' },
	{ name: '自动化脚本', id: 'automation-projects' },
	{ name: 'AI 项目', id: 'ai-projects' },
] as const;
const statusClassMap = {
	已完成: 'done',
	进行中: 'active',
	实验: 'experimental',
	暂停: 'paused',
} as const satisfies Record<ProjectStatus, string>;

const groupedProjects = projectTypes
	.map((type) => ({
		...type,
		items: projects.filter((project) => project.type === type.name),
	}))
	.filter((group) => group.items.length > 0);

const base = import.meta.env.BASE_URL;
---

<Layout
	title="项目 | Dead Soul Insects"
	description="Dead Soul Insects 的真实项目入口页，按类型整理站点项目、自动化脚本与 AI 实践。"
	canonicalPath="/projects/"
>
	<div class="editorial-page projects-page">
		<header class="projects-intro">
			<p class="kicker">Projects</p>
			<h1>项目</h1>
			<p class="lead">这里收录已经做出的网页实践，以及支撑本站内容发布与长期维护的工具和流程。</p>
		</header>

		<nav class="type-index" aria-label="项目类别">
			{groupedProjects.map((group) => (
				<a href={`#${group.id}`}>
					<span>{group.name}</span>
					<small>{String(group.items.length).padStart(2, '0')} <span aria-hidden="true">↓</span></small>
				</a>
			))}
		</nav>

		<section class="project-directory" aria-label="项目目录">
			<div class="project-groups">
				{groupedProjects.map((group) => (
					<section class="project-group" id={group.id} aria-labelledby={`${group.id}-title`}>
						<header class="project-group-head">
							<h2 id={`${group.id}-title`}>{group.name}</h2>
							<span>{String(group.items.length).padStart(2, '0')}</span>
						</header>

						<div class="project-list">
							{group.items.map((project) => (
								<article class="project-row">
									<div>
										<div class="project-row-meta">
											<span class:list={['status', statusClassMap[project.status]]}>{project.status}</span>
										</div>
										<h3 class="project-name">{project.name}</h3>
										<p class="project-purpose">{project.purpose}</p>
										{project.links && (
											<div class="project-links">
												{project.links.map((link) => (
													<a
														href={link.external ? link.href : withBase(base, link.href)}
														target={link.external ? '_blank' : undefined}
														rel={link.external ? 'noreferrer' : undefined}
													>
														{link.label}
													</a>
												))}
											</div>
										)}
									</div>
								</article>
							))}
						</div>
					</section>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.projects-page {
		display: grid;
		gap: var(--space-8);
	}

	.projects-intro {
		max-width: var(--reading-measure);
		padding: var(--space-8) 0 var(--space-3);
	}

	.projects-intro h1 {
		margin-top: var(--space-3);
		font-family: var(--font-display);
		font-size: var(--text-section);
		font-weight: 500;
		line-height: 1.08;
	}

	.projects-intro .lead {
		max-width: 38rem;
		margin-top: var(--space-4);
	}

	.type-index {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-top: var(--rule-thin) solid var(--line);
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.type-index a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		min-width: 0;
		padding: var(--space-4);
		color: var(--text);
		text-decoration: none;
	}

	.type-index a + a {
		border-left: var(--rule-thin) solid var(--line);
	}

	.type-index small {
		color: var(--text-soft);
		font-size: var(--text-meta);
		font-variant-numeric: tabular-nums;
	}

	.type-index a:is(:hover, :focus-visible) {
		background: color-mix(in srgb, var(--panel) 72%, transparent);
		color: var(--accent-soft);
	}

	.project-group-head,
	.project-row-meta {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.project-row-meta,
	.project-group-head span {
		color: var(--text-soft);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-date);
	}

	.project-groups {
		display: grid;
		gap: var(--space-7);
	}

	.project-group {
		display: block;
		min-width: 0;
		scroll-margin-top: var(--space-9);
	}

	.project-group-head {
		margin-bottom: var(--space-3);
	}

	.project-group h2,
	.project-name {
		font-family: var(--font-display);
		font-weight: 500;
		line-height: 1.2;
	}

	.project-group h2 {
		font-size: var(--text-note);
	}

	.project-name {
		font-family: var(--font-ui);
		font-weight: 600;
	}

	.project-list {
		min-width: 0;
		border-top: var(--rule-thin) solid var(--line);
	}

	.project-row {
		padding: var(--space-5) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.project-row-meta {
		justify-content: flex-start;
		margin-bottom: var(--space-2);
	}

	.project-row-meta .status {
		color: var(--text-soft);
	}

	.status {
		color: var(--text-soft);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-date);
		white-space: nowrap;
	}

	.status.done {
		color: var(--accent-soft);
	}

	.status.active {
		color: var(--text);
	}

	.project-name {
		font-size: var(--text-row);
	}

	.project-purpose {
		max-width: var(--list-measure);
		margin-top: var(--space-2);
		color: var(--text-soft);
		line-height: 1.68;
	}

	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3) var(--space-4);
		margin-top: var(--space-3);
	}

	.project-links a {
		color: var(--accent-soft);
		font-size: var(--text-small);
		text-decoration: underline;
		text-decoration-color: transparent;
		text-underline-offset: var(--space-1);
	}

	.project-links a:is(:hover, :focus-visible) {
		text-decoration-color: currentColor;
	}

	@media (max-width: 820px) {
		.projects-page {
			gap: var(--space-7);
		}

		.projects-intro {
			padding-top: var(--space-6);
		}
	}

	@media (max-width: 520px) {
		.type-index {
			grid-template-columns: minmax(0, 1fr);
		}

		.type-index a + a {
			border-top: var(--rule-thin) solid var(--line);
			border-left: 0;
		}
	}
</style>
