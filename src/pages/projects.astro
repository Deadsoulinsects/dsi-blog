---
import Layout from '../layouts/Layout.astro';

type ProjectStatus = '已完成' | '进行中' | '实验' | '暂停';

interface ProjectLink {
	label: string;
	href: string;
	external?: boolean;
}

interface ProjectItem {
	name: string;
	purpose: string;
	status: ProjectStatus;
	type: string;
	links?: ProjectLink[];
}

const projects: ProjectItem[] = [
	{
		name: 'Dead Soul Insects 站点',
		purpose: '把博客、项目记录、说明文档与起源页收进同一个 Astro 静态站点里，作为长期维护中的公开入口。',
		status: '进行中',
		type: '站点项目',
		links: [
			{ label: '打开首页', href: '/' },
			{ label: '查看使用说明', href: '/docs/intro/' },
		],
	},
	{
		name: '项目页档案化改造',
		purpose: '把原本偏说明性的项目页改成真实条目入口，并验证更紧凑的档案式浏览是否适合后续维护。',
		status: '实验',
		type: '站点项目',
	},
	{
		name: 'Obsidian 到博客内容流',
		purpose: '先在本地笔记里沉淀原始记录，再整理成适合公开的博客内容，减少把私人工作区直接搬上站点。',
		status: '进行中',
		type: '自动化脚本',
		links: [{ label: '查看 Obsidian 专题', href: '/blog/topics/obsidian/' }],
	},
	{
		name: '内容准备与构建检查脚本',
		purpose: '在发布前补齐内容准备、链接检查与纯构建验证，尽量把高风险步骤留在正式发布之前。',
		status: '已完成',
		type: '自动化脚本',
		links: [
			{ label: '文档入口', href: '/docs/' },
			{ label: '使用说明', href: '/docs/intro/' },
		],
	},
	{
		name: 'SBTI 2.0',
		purpose: '围绕人格测试、结果页表现、BGM 氛围和部署上线做出来的 AI 小型网页实践。',
		status: '已完成',
		type: 'AI 项目',
		links: [
			{ label: '查看 SBTI 专题', href: '/blog/topics/sbti/' },
			{ label: '项目站点', href: 'https://sbti2.deadsoulinsects.cn', external: true },
		],
	},
];

const typeDescriptions: Record<string, string> = {
	站点项目: '围绕站点本体、页面入口和公开结构的持续维护。',
	自动化脚本: '服务于内容准备、同步与构建检查的实际流程工具。',
	'AI 项目': '已经做出可演示结果，或已经留下阶段记录的 AI 实践。',
};

const typeOrder = ['站点项目', '自动化脚本', 'AI 项目'];
const statusOrder: ProjectStatus[] = ['已完成', '进行中', '实验', '暂停'];
const statusClassMap: Record<ProjectStatus, string> = {
	已完成: 'done',
	进行中: 'active',
	实验: 'experimental',
	暂停: 'paused',
};

const groupedProjects = typeOrder
	.map((type) => {
		const items = projects.filter((project) => project.type === type);

		return {
		type,
		description: typeDescriptions[type],
		items,
		previewNames: items.slice(0, 2).map((project) => project.name),
		statusBreakdown: statusOrder
			.map((status) => ({
				status,
				count: items.filter((project) => project.status === status).length,
			}))
			.filter((item) => item.count > 0),
		};
	})
	.filter((group) => group.items.length > 0);

const statusCounts = statusOrder.map((status) => ({
	status,
	count: projects.filter((project) => project.status === status).length,
}));

const topCardStatusSummary = statusCounts
	.filter((item) => item.count > 0)
	.map((item) => `${item.status} ${item.count}`)
	.join('、');

---

<Layout
	title="项目 | Dead Soul Insects"
	description="Dead Soul Insects 的真实项目入口页，按类型整理站点项目、自动化脚本与 AI 实践。"
	canonicalPath="/projects/"
>
	<div class="page-shell">
		<section class="page-card intro-card">
			<header class="page-intro">
				<div class="intro-copy">
					<p class="kicker">项目</p>
					<h1>只把真实做过的项目，压成清楚入口</h1>
					<p class="lead">
						这一页现在只整理已经有依据的项目条目：要么已经做出来，要么正在维护，要么至少已经留下了可继续追踪的实验记录。状态说明成熟度，类型负责说明它属于哪一类实践。
					</p>
				</div>

				<div class="intro-index" aria-label="项目概览">
					<div class="intro-index-item">
						<span class="index-label">项目条目</span>
						<strong>{projects.length}</strong>
					</div>
					<div class="intro-index-item muted">
						<span class="index-label">类型分区</span>
						<strong>{groupedProjects.length}</strong>
					</div>
				</div>
			</header>

			<div class="intro-note">
				<p>当前收录的项目以 {topCardStatusSummary} 为主，先按类型缩小范围，会比把所有项目一次摊平更适合继续维护和回看。</p>
			</div>
		</section>

		<section class="page-card section-card" aria-label="项目类型入口">
			<div class="section-heading">
				<div class="section-copy">
					<p class="kicker">类型</p>
					<h2>先按实践类别进入</h2>
				</div>
				<p class="section-note">保留类型说明、状态分布和条目预览，先判断属于哪一类实践，再继续进入相关页面或专题。</p>
			</div>

			<div class="type-list">
				{groupedProjects.map((group) => (
					<article class="entry-card type-entry-card">
						<div class="entry-main">
							<div class="entry-header">
								<div class="entry-copy">
									<p class="entry-kicker">项目类型</p>
									<h3>{group.type}</h3>
									<p>{group.description}</p>
								</div>

								<div class="entry-index" aria-hidden="true">
									<span class="index-label">条目</span>
									<strong>{group.items.length}</strong>
								</div>
							</div>

							<div class="entry-badges" aria-label={`${group.type} 状态提示`}>
								{group.statusBreakdown.map((item) => (
									<span class:list={['badge', 'status-badge', statusClassMap[item.status]]}>{item.status} {item.count}</span>
								))}
							</div>

							<div class="entry-preview" aria-label={`${group.type} 项目预览`}>
								<span class="preview-label">条目预览</span>
								<p>
									{group.previewNames.join(' / ')}
									{group.items.length > group.previewNames.length ? ' 等' : ''}
								</p>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-shell {
		display: grid;
		gap: clamp(22px, 2.8vw, 30px);
	}

	.page-card,
		.entry-card {
		border: 1px solid var(--line);
		backdrop-filter: var(--glass-blur);
		box-sizing: border-box;
	}

	.page-card {
		padding: clamp(24px, 3.4vw, 34px);
		border-radius: var(--radius-panel);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)),
			var(--panel);
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22);
		overflow: clip;
	}

	.page-card {
		gap: 20px;
	}

	.page-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.7fr);
		align-items: start;
		gap: 24px;
	}

	.intro-card,
	.section-card,
	.intro-copy,
	.section-copy,
	.entry-copy,
	.entry-main {
		display: grid;
		gap: 12px;
	}

	.intro-copy {
		max-width: 40rem;
	}

	.intro-index {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		align-content: start;
	}

	.intro-index-item,
	.entry-index {
		display: grid;
		gap: 8px;
		padding: 16px 18px;
		border: 1px solid rgba(153, 176, 255, 0.14);
		border-radius: 20px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.022), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel-strong) 84%, transparent);
		box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
	}

	.intro-index-item.muted {
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel) 88%, transparent);
	}

	.intro-index-item strong,
	.entry-index strong {
		font-size: 1.05rem;
		line-height: 1;
		color: var(--text);
	}

	.intro-note {
		padding-top: 2px;
		border-top: 1px solid rgba(153, 176, 255, 0.12);
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
		gap: 14px;
		align-items: end;
	}

	.section-copy {
		gap: 8px;
	}

	.section-note {
		max-width: 36rem;
		align-self: end;
	}

	.kicker {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.entry-kicker,
	.index-label,
	.preview-label {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-soft);
	}

	h1,
	h2,
	h3,
	p,
	span,
	strong {
		margin: 0;
		overflow-wrap: anywhere;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
	}

	h2 {
		font-size: clamp(1.35rem, 2.5vw, 1.8rem);
		line-height: 1.16;
	}

	h3 {
		font-size: clamp(1.18rem, 2vw, 1.4rem);
		line-height: 1.22;
	}

	p {
		color: var(--text-soft);
		line-height: 1.78;
	}

	.lead {
		font-size: 1.02rem;
	}

	.type-list {
		display: grid;
		gap: 14px;
	}

	.entry-card {
		padding: 20px 22px;
		border-radius: 20px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.024), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel) 90%, var(--bg));
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
		transition:
			transform 0.18s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	.entry-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 20px;
		align-items: start;
	}

	.entry-copy {
		min-width: 0;
	}

	.entry-index {
		justify-items: end;
		text-align: right;
		min-width: 7.25rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 28px;
		padding: 5px 10px;
		border-radius: var(--radius-pill);
		font-size: 0.82rem;
		border: 1px solid rgba(153, 176, 255, 0.16);
		background: rgba(255, 255, 255, 0.045);
		color: var(--text-soft);
	}

	.status-badge.done {
		border-color: rgba(157, 140, 255, 0.3);
		background: rgba(157, 140, 255, 0.12);
		color: #ddd6ff;
	}

	.status-badge.active {
		border-color: rgba(110, 195, 255, 0.28);
		background: rgba(110, 195, 255, 0.1);
		color: #bce9ff;
	}

	.status-badge.experimental {
		border-color: rgba(138, 198, 255, 0.22);
		background: rgba(138, 198, 255, 0.08);
		color: #d4edff;
	}

	.status-badge.paused {
		border-color: rgba(164, 176, 211, 0.22);
		background: rgba(164, 176, 211, 0.08);
		color: #cfd7f2;
	}

	.entry-badges {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.preview-label {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		padding: 4px 10px;
		border: 1px solid rgba(153, 176, 255, 0.14);
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.04);
		color: var(--text-soft);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	.entry-preview {
		display: grid;
		gap: 8px;
		padding-top: 4px;
		border-top: 1px solid rgba(153, 176, 255, 0.1);
	}

	.entry-preview p {
		color: var(--text);
		line-height: 1.7;
	}

	.entry-card:is(:hover, :focus-within) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel-strong) 90%, var(--bg));
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.16);
	}

	@media (max-width: 960px) {
		.page-intro,
		.section-heading,
		.intro-index,
		.entry-header {
			grid-template-columns: 1fr;
		}

		.entry-index {
			justify-items: start;
			text-align: left;
			min-width: 0;
		}
	}

	@media (max-width: 640px) {
		.page-card {
			padding: 20px;
		}

		.entry-card {
			padding: 18px;
		}
	}
</style>
