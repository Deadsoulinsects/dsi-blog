---
import Layout from '../layouts/Layout.astro';
import { formatDateTime, getArchiveGroups } from '../utils/content';
import { withBase } from '../utils/paths';

const groups = await getArchiveGroups();
const totalPosts = groups.reduce((sum, group) => sum + group.items.length, 0);
const base = import.meta.env.BASE_URL;
---

<Layout title="归档 | Dead Soul Insects" description="按时间查看 Dead Soul Insects 的博客文章归档。" canonicalPath="/archive/">
	<div class="editorial-page archive-page">
		<section class="intro">
			<div class="intro-grid">
				<div>
					<p class="kicker">归档</p>
					<h1>按时间回看留下来的记录</h1>
				</div>

				<div class="intro-side">
					<p class="lead">这里按年份整理博客文章，方便先定位时间段，再继续进入具体记录。</p>

					<div class="intro-index" aria-label="归档概览">
						<div class="intro-stat">
							<span>年份分组</span>
							<strong>{groups.length}</strong>
						</div>
						<div class="intro-stat">
							<span>归档文章</span>
							<strong>{totalPosts}</strong>
						</div>
					</div>

					<p class="intro-note">先按年份缩小范围，再顺着标题回看，会比把所有文章直接摊平更适合归档检索。</p>
				</div>
			</div>
		</section>

		<section class="section" aria-label="文章归档列表">
			<div class="archive-stack">
				{groups.map((group) => (
					<section class="archive-frame" aria-labelledby={`archive-year-${group.year}`}>
						<header>
							<h2 class="archive-year" id={`archive-year-${group.year}`}>{group.year}</h2>
							<p class="archive-year-meta">文章 · {group.items.length}</p>
						</header>

						<ul class="archive-list">
							{group.items.map((post) => {
								const dateTime = formatDateTime(post.data.pubDate);

								return (
									<li>
										<time class="archive-date" datetime={dateTime}>{dateTime.slice(5).replace('-', '.')}</time>
										<a class="archive-link" href={withBase(base, `/blog/${post.id}/`)}>{post.data.title}</a>
									</li>
								);
							})}
						</ul>
					</section>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.archive-stack {
		display: grid;
		gap: var(--space-8);
	}

	.archive-frame {
		display: grid;
		grid-template-columns: var(--column-archive-year) minmax(0, 1fr);
		gap: var(--space-6);
		min-width: 0;
	}

	.archive-year {
		font-family: var(--font-ui);
		font-size: var(--text-year);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: var(--tracking-tight);
		font-variant-numeric: lining-nums tabular-nums;
		white-space: nowrap;
	}

	.archive-year-meta {
		margin-top: var(--space-3);
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-date);
	}

	.archive-list {
		padding: 0;
		list-style: none;
		border-top: var(--rule-strong) solid var(--text);
	}

	.archive-list li {
		display: grid;
		grid-template-columns: var(--column-archive-date) minmax(0, 1fr);
		gap: var(--space-4);
		padding: var(--space-4) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.archive-date {
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-kicker);
		letter-spacing: var(--tracking-meta);
		font-variant-numeric: tabular-nums lining-nums;
	}

	.archive-link {
		min-width: 0;
		font-family: var(--font-reading);
		font-size: var(--text-body);
		line-height: 1.45;
		text-decoration: none;
		transition: color var(--duration-fast) ease;
	}

	.archive-link:is(:hover, :focus-visible) {
		color: var(--accent-soft);
	}

	@media (max-width: 760px) {
		.archive-frame {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-5);
		}
	}

	@media (max-width: 460px) {
		.archive-list li {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-1);
		}
	}
</style>
