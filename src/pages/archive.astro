---
import Layout from '../layouts/Layout.astro';
import { formatDateTime, getArchiveGroups } from '../utils/content';
import { withBase } from '../utils/paths';

const groups = await getArchiveGroups();
const base = import.meta.env.BASE_URL;
---

<Layout title="归档 | Dead Soul Insects" description="按时间查看 Dead Soul Insects 的博客文章归档。" canonicalPath="/archive/">
	<div class="archive-page">
		<header class="archive-heading">
			<h1>归档</h1>
			<p>博客文章，按完成日期由近到远。</p>
		</header>

		<section aria-label="文章归档列表">
			<div class="archive-stack">
				{groups.map((group) => (
					<section class="archive-frame" aria-labelledby={`archive-year-${group.year}`}>
						<header>
							<h2 class="archive-year" id={`archive-year-${group.year}`}>{group.year}</h2>
							<p class="archive-year-meta">{group.items.length} 篇</p>
						</header>

						<ul class="archive-list">
							{group.items.map((post) => {
								const dateTime = formatDateTime(post.data.completion_date);

								return (
									<li>
										<time class="archive-date" datetime={dateTime}>{dateTime.slice(5).replace('-', '.')}</time>
										<a class="archive-link" href={withBase(base, `/blog/${post.id}/`)}>{post.data.title}</a>
									</li>
								);
							})}
						</ul>
					</section>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.archive-heading {
		margin-bottom: var(--space-7);
		padding-top: var(--space-4);
	}

	.archive-heading h1 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.archive-heading p {
		margin: var(--space-3) 0 0;
		color: var(--text-soft);
		font-size: var(--text-note);
		line-height: 1.7;
	}

	.archive-stack {
		display: grid;
		gap: var(--space-7);
	}

	.archive-frame {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		gap: var(--space-6);
		min-width: 0;
	}

	.archive-frame:not(:first-child) {
		padding-top: var(--space-7);
		border-top: var(--rule-thin) solid var(--line);
	}

	.archive-year {
		margin: 0;
		font-family: var(--font-ui);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: var(--tracking-tight);
		font-variant-numeric: lining-nums tabular-nums;
		white-space: nowrap;
	}

	.archive-year-meta {
		margin: var(--space-2) 0 0;
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-date);
	}

	.archive-list {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: var(--rule-thin) solid var(--line);
	}

	.archive-frame:not(:first-child) .archive-list {
		border-top: 0;
	}

	.archive-list li {
		display: grid;
		grid-template-columns: max-content minmax(0, 1fr);
		align-items: baseline;
		gap: var(--space-4);
		padding: var(--space-4) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.archive-date {
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		line-height: 1.6;
		overflow-wrap: anywhere;
		font-variant-numeric: tabular-nums lining-nums;
	}

	.archive-link {
		min-width: 0;
		font-family: var(--font-display);
		font-size: var(--text-body);
		line-height: 1.6;
		overflow-wrap: anywhere;
		text-decoration: none;
	}

	.archive-link:is(:hover, :focus-visible) {
		color: var(--accent-soft);
	}

	@media (max-width: 760px) {
		.archive-frame {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-5);
		}
	}

	@media (max-width: 460px) {
		.archive-list li {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-1);
		}
	}
</style>
