---
import { featuredTopics } from '../data/topics';
import Layout from '../layouts/Layout.astro';
import { formatDateTime, getSortedPosts } from '../utils/content';
import { withBase } from '../utils/paths';
import { getTopicGroups } from '../utils/topics';

const posts = await getSortedPosts();
const topicGroups = getTopicGroups(posts);
const featuredTopicGroups = featuredTopics
	.map((topicName) => topicGroups.find((topicGroup) => topicGroup.name === topicName))
	.filter((topicGroup): topicGroup is (typeof topicGroups)[number] => topicGroup !== undefined);
const latestArchiveYear = posts.at(0)?.data.pubDate.getUTCFullYear();
const archivePreviewPosts = latestArchiveYear === undefined
	? []
	: posts.filter((post) => post.data.pubDate.getUTCFullYear() === latestArchiveYear);
const base = import.meta.env.BASE_URL;
---

<Layout title="博客 | Dead Soul Insects" description="Dead Soul Insects 的博客列表页。" canonicalPath="/blog/">
	<div class="editorial-page blog-page">
		<section class="intro blog-hero" aria-labelledby="blog-title">
			<div class="intro-grid blog-hero-grid">
				<div class="blog-hero-column">
					<h1 id="blog-title">
						记录做过的东西，<br />
						遇到的问题，<br />
						正在思考的事情
					</h1>
					<p class="blog-hero-note">
						打发时间、娱乐自己
					</p>

					<div class="intro-index blog-stats" aria-label="博客概览">
						<div class="intro-stat">
							<span>文章</span>
							<strong>{posts.length}</strong>
						</div>
						<div class="intro-stat">
							<span>专题</span>
							<strong>{topicGroups.length}</strong>
						</div>
					</div>
				</div>

				<nav class="blog-hero-column" aria-labelledby="featured-topics-title">
					<header class="blog-topic-heading">
						<h2 class="row-title" id="featured-topics-title">专题</h2>
						<a class="blog-topic-all" href={withBase(base, '/blog/topics/')}>查看全部</a>
					</header>

					<div class="rule-list blog-topic-list">
						{featuredTopicGroups.map((topicGroup) => {
							const description = topicGroup.description?.trim();

							return (
								<a class="rule-row topic-row text-link" href={withBase(base, `/blog/topics/${topicGroup.slug}/`)}>
									<div class="topic-copy">
										<h3 class="row-title">{topicGroup.name}</h3>
										{description && <p class="row-copy">{description}</p>}
									</div>
									<span class="topic-count">{topicGroup.posts.length} 篇</span>
								</a>
							);
						})}
					</div>
				</nav>
			</div>
		</section>

		<section class="section" aria-labelledby="posts-title">
			<header class="section-copy blog-section-heading">
				<h2 id="posts-title">文章</h2>
			</header>

			<div class="rule-list">
				{posts.map((post) => {
					const dateTime = formatDateTime(post.data.pubDate);
					const topic = post.data.topic.trim();

					return (
						<a class="rule-row post-row text-link" href={withBase(base, `/blog/${post.id}/`)}>
							<div class="post-meta">
								<time datetime={dateTime}>{dateTime.replaceAll('-', '.')}</time>
								{topic && <span class="post-topic">{topic}</span>}
							</div>
							<article>
								<h3 class="row-title">{post.data.title}</h3>
								<p class="post-description">{post.data.description}</p>
							</article>
						</a>
					);
				})}
			</div>
		</section>

		{latestArchiveYear !== undefined && (
			<section class="section" aria-labelledby="archive-preview-title">
				<header class="section-copy blog-section-heading">
					<h2 id="archive-preview-title">归档</h2>
				</header>

				<div class="archive-frame">
					<div>
						<h3 class="archive-year">{latestArchiveYear}</h3>
						<p class="archive-year-meta">文章 · {archivePreviewPosts.length}</p>
					</div>

					<div class="archive-preview-list">
						<ul class="archive-list">
							{archivePreviewPosts.map((post) => {
								const dateTime = formatDateTime(post.data.pubDate);

								return (
									<li>
										<time class="archive-date" datetime={dateTime}>{dateTime.slice(5).replace('-', '.')}</time>
										<a class="archive-link" href={withBase(base, `/blog/${post.id}/`)}>{post.data.title}</a>
									</li>
								);
							})}
						</ul>
						<a class="arrow-link archive-more" href={withBase(base, '/archive/')}>查看完整归档 <span aria-hidden="true">→</span></a>
					</div>
				</div>
			</section>
		)}
	</div>
</Layout>

<style>
	.blog-page .intro {
		border-bottom: 0;
	}

	.blog-page section[aria-labelledby='posts-title'],
	.blog-page section[aria-labelledby='archive-preview-title'] {
		border-bottom: 0;
	}

	.blog-hero-grid {
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr);
		align-items: stretch;
	}

	.blog-hero-column {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	#blog-title {
		max-width: 11em;
		font-size: clamp(2rem, 3.5vw, 2.8rem);
		line-height: 1.18;
		letter-spacing: -0.035em;
		text-wrap: initial;
	}

	.blog-hero-note {
		margin: 0.5rem 0 0.5rem;
		max-width: 28rem;
		color: var(--text-soft);
		font-size: 0.8rem;
		line-height: 1.75;
	}

	.blog-stats,
	.blog-topic-list {
		margin-top: auto;
	}

	.blog-topic-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.blog-topic-all {
		flex: 0 0 auto;
		color: var(--accent-soft);
		font-family: var(--font-meta);
		font-size: var(--text-kicker);
		letter-spacing: var(--tracking-meta);
		text-decoration: none;
		white-space: nowrap;
	}

	.blog-topic-all:is(:hover, :focus-visible) {
		text-decoration: underline;
		text-underline-offset: var(--space-1);
	}

	.blog-topic-list {
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.blog-topic-list .topic-row:last-child {
		border-bottom: 0;
	}

	.blog-section-heading {
		margin-bottom: var(--space-6);
	}

	.topic-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--column-contact-action);
		gap: var(--space-2) var(--space-5);
	}

	.topic-copy {
		display: contents;
		min-width: 0;
	}

	.blog-topic-list .row-title {
		grid-column: 1;
		grid-row: 1;
	}

	.blog-topic-list .row-copy {
		grid-column: 1 / -1;
		grid-row: 2;
		margin-top: 0;
	}

	.topic-count {
		grid-column: 2;
		grid-row: 1;
		align-self: start;
		justify-self: end;
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-kicker);
		font-variant-numeric: tabular-nums lining-nums;
		white-space: nowrap;
	}

	.post-row {
		display: grid;
		grid-template-columns: var(--column-post-meta) minmax(0, 1fr);
		gap: var(--space-6);
	}

	.post-row article {
		min-width: 0;
	}

	.post-meta {
		display: grid;
		align-content: start;
		gap: var(--space-2);
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		line-height: 1.5;
	}

	.post-meta time {
		letter-spacing: var(--tracking-date);
		font-variant-numeric: tabular-nums lining-nums;
	}

	.post-topic {
		color: var(--accent-soft);
	}

	.row-copy,
	.post-description {
		overflow-wrap: normal;
		word-break: auto-phrase;
		text-wrap: pretty;
	}

	.post-description {
		max-width: var(--list-measure);
		margin-top: var(--space-3);
		color: var(--text-soft);
		font-size: var(--text-body);
		line-height: 1.72;
	}

	.archive-frame {
		display: grid;
		grid-template-columns: var(--column-archive-year) minmax(0, 1fr);
		gap: var(--space-6);
		padding-top: var(--space-2);
	}

	.archive-year {
		font-family: var(--font-ui);
		font-size: var(--text-year);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: var(--tracking-tight);
		font-variant-numeric: lining-nums tabular-nums;
		white-space: nowrap;
		margin-top: var(--space-2);
	}

	.archive-year-meta {
		margin-top: var(--space-3);
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-date);
	}

	.archive-list {
		position: relative;
		padding: 0;
		list-style: none;
		border-top: var(--rule-strong) solid var(--text);
	}

	.archive-list::before {
		content: '';
		position: absolute;
		top: calc(-1 * var(--rule-strong));
		right: 100%;
		width: calc(var(--column-archive-year) + var(--space-6));
		height: var(--rule-strong);
		background: var(--text);
	}

	.archive-list li {
		display: grid;
		grid-template-columns: var(--column-archive-date) minmax(0, 1fr);
		gap: var(--space-4);
		padding: var(--space-4) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.archive-list li:last-child {
		border-bottom: 0;
	}

	.archive-date {
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-kicker);
		letter-spacing: var(--tracking-meta);
		font-variant-numeric: tabular-nums lining-nums;
	}

	.archive-link {
		font-family: var(--font-reading);
		font-size: var(--text-body);
		line-height: 1.45;
		text-decoration: none;
		transition: color var(--duration-fast) ease;
	}

	.archive-link:is(:hover, :focus-visible) {
		color: var(--accent-soft);
	}

	.archive-more {
		margin-top: var(--space-5);
	}

	@media (max-width: 768px) {
		.blog-hero-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-7);
		}

		#blog-title {
			max-width: 12em;
			font-size: clamp(2rem, 8vw, 2.8rem);
			line-height: 1.16;
		}

		.blog-hero-note {
			max-width: none;
			font-size: 0.95rem;
		}

		.topic-row,
		.post-row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3);
		}

		.topic-copy {
			display: block;
		}

		.blog-topic-list .row-copy {
			margin-top: var(--space-2);
		}

		.topic-count {
			grid-column: auto;
			grid-row: auto;
			justify-self: start;
		}

		.post-meta {
			grid-template-columns: max-content max-content;
		}

		.archive-frame {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-5);
		}

		.archive-list::before {
			display: none;
		}
	}

	@media (max-width: 460px) {
		.blog-page .blog-stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.blog-page .blog-stats .intro-stat + .intro-stat {
			padding-left: var(--space-4);
			border-top: 0;
			border-left: var(--rule-thin) solid var(--line);
		}

		.archive-list li {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-1);
		}
	}
</style>
