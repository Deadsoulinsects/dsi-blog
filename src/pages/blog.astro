---
import Layout from '../layouts/Layout.astro';
import { formatDateTime, getSortedPosts } from '../utils/content';
import { withBase } from '../utils/paths';
import { getTopicGroups } from '../utils/topics';

const posts = await getSortedPosts();
const topicGroups = getTopicGroups(posts);
const latestArchiveYear = posts.at(0)?.data.pubDate.getUTCFullYear();
const archivePreviewPosts = latestArchiveYear === undefined
	? []
	: posts.filter((post) => post.data.pubDate.getUTCFullYear() === latestArchiveYear);
const base = import.meta.env.BASE_URL;
---

<Layout title="博客 | Dead Soul Insects" description="Dead Soul Insects 的博客列表页。" canonicalPath="/blog/">
	<div class="editorial-page blog-page">
		<section class="intro">
			<div class="intro-grid">
				<div>
					<p class="kicker">博客</p>
					<h1>持续写下来的记录</h1>
				</div>

				<div class="intro-side">
					<p class="lead">这里优先按已经成形的专题进入，其余文章继续按时间向下展开。</p>

					<div class="intro-index" aria-label="博客概览">
						<div class="intro-stat">
							<span>公开文章</span>
							<strong>{posts.length}</strong>
						</div>
						<div class="intro-stat">
							<span>专题入口</span>
							<strong>{topicGroups.length}</strong>
						</div>
					</div>

					<p class="intro-note">先看专题，再继续按时间浏览，会比把所有文章一次摊平更容易形成稳定的阅读路径。</p>
				</div>
			</div>
		</section>

		{topicGroups.length > 0 && (
			<section class="section" aria-labelledby="topics-title">
				<header class="section-heading">
					<span class="section-index">01 / TOPICS</span>
					<div class="section-copy">
						<p class="kicker">专题</p>
						<h2 id="topics-title">先按主题进入</h2>
						<p class="section-note">已经形成线索的内容会先收进专题，方便顺着一条线继续看下去。</p>
					</div>
				</header>

				<div class="rule-list">
					{topicGroups.map((topicGroup) => (
							<a class="rule-row topic-row text-link" href={withBase(base, `/blog/topics/${topicGroup.slug}/`)}>
								<div>
									<h3 class="row-title">{topicGroup.name}</h3>
									<p class="row-copy">{topicGroup.description?.trim() || '继续沿着同一条内容线索往下读。'}</p>
								</div>
							<span class="topic-count">{topicGroup.posts.length} 篇</span>
						</a>
					))}
				</div>
			</section>
		)}

		<section class="section" aria-labelledby="posts-title">
			<header class="section-heading">
				<span class="section-index">02 / POSTS</span>
				<div class="section-copy">
					<p class="kicker">文章</p>
					<h2 id="posts-title">公开文章</h2>
				</div>
			</header>

			<div class="rule-list">
				{posts.map((post) => {
					const dateTime = formatDateTime(post.data.pubDate);
					const topic = post.data.topic.trim();

					return (
						<a class="rule-row post-row text-link" href={withBase(base, `/blog/${post.id}/`)}>
							<div class="post-meta">
								<time datetime={dateTime}>{dateTime.replaceAll('-', '.')}</time>
								{topic && <span>{topic}</span>}
							</div>
							<article>
								<h3 class="row-title">{post.data.title}</h3>
								<p class="post-description">{post.data.description}</p>
							</article>
						</a>
					);
				})}
			</div>
		</section>

		{latestArchiveYear !== undefined && (
			<section class="section" aria-labelledby="archive-preview-title">
				<header class="section-heading">
					<span class="section-index">03 / ARCHIVE</span>
					<div class="section-copy">
						<p class="kicker">归档</p>
						<h2 id="archive-preview-title">按时间回看留下来的记录</h2>
						<p class="section-note">这里按年份整理博客文章，方便先定位时间段，再继续进入具体记录。</p>
					</div>
				</header>

				<div class="archive-frame">
					<div>
						<h3 class="archive-year">{latestArchiveYear}</h3>
						<p class="archive-year-meta">文章 · {archivePreviewPosts.length}</p>
					</div>

					<div class="archive-preview-list">
						<ul class="archive-list">
							{archivePreviewPosts.map((post) => {
								const dateTime = formatDateTime(post.data.pubDate);

								return (
									<li>
										<time class="archive-date" datetime={dateTime}>{dateTime.slice(5).replace('-', '.')}</time>
										<a class="archive-link" href={withBase(base, `/blog/${post.id}/`)}>{post.data.title}</a>
									</li>
								);
							})}
						</ul>
						<a class="arrow-link archive-more" href={withBase(base, '/archive/')}>查看完整归档 <span aria-hidden="true">→</span></a>
					</div>
				</div>
			</section>
		)}
	</div>
</Layout>

<style>
	.topic-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--column-contact-action);
		gap: var(--space-5);
	}

	.topic-count {
		justify-self: end;
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-kicker);
		font-variant-numeric: tabular-nums lining-nums;
	}

	.post-row {
		display: grid;
		grid-template-columns: var(--column-post-meta) minmax(0, 1fr);
		gap: var(--space-6);
	}

	.post-row article {
		min-width: 0;
	}

	.post-meta {
		display: grid;
		align-content: start;
		gap: var(--space-2);
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		line-height: 1.5;
	}

	.post-meta time {
		letter-spacing: var(--tracking-date);
		font-variant-numeric: tabular-nums lining-nums;
	}

	.post-description {
		max-width: var(--list-measure);
		margin-top: var(--space-3);
		color: var(--text-soft);
		font-size: var(--text-body);
		line-height: 1.72;
	}

	.archive-frame {
		display: grid;
		grid-template-columns: var(--column-archive-year) minmax(0, 1fr);
		gap: var(--space-6);
		padding-top: var(--space-2);
	}

	.archive-year {
		font-family: var(--font-ui);
		font-size: var(--text-year);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: var(--tracking-tight);
		font-variant-numeric: lining-nums tabular-nums;
		white-space: nowrap;
	}

	.archive-year-meta {
		margin-top: var(--space-3);
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		letter-spacing: var(--tracking-date);
	}

	.archive-list {
		padding: 0;
		list-style: none;
		border-top: var(--rule-strong) solid var(--text);
	}

	.archive-list li {
		display: grid;
		grid-template-columns: var(--column-archive-date) minmax(0, 1fr);
		gap: var(--space-4);
		padding: var(--space-4) 0;
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.archive-date {
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-kicker);
		letter-spacing: var(--tracking-meta);
		font-variant-numeric: tabular-nums lining-nums;
	}

	.archive-link {
		font-family: var(--font-reading);
		font-size: var(--text-body);
		line-height: 1.45;
		text-decoration: none;
		transition: color var(--duration-fast) ease;
	}

	.archive-link:is(:hover, :focus-visible) {
		color: var(--accent-soft);
	}

	.archive-more {
		margin-top: var(--space-5);
	}

	@media (max-width: 760px) {
		.topic-row,
		.post-row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3);
		}

		.topic-count {
			justify-self: start;
		}

		.post-meta {
			grid-template-columns: max-content max-content;
		}

		.archive-frame {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-5);
		}
	}

	@media (max-width: 460px) {
		.archive-list li {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-1);
		}
	}
</style>
