---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';

interface OriginSection {
	readonly title: string;
	readonly description: string;
	readonly link?: {
		readonly href: string;
		readonly label: string;
	};
}

const originSections: readonly OriginSection[] = [
	{
		title: 'Dead Soul Insects 名字来源',
		description:
			'这个名字被保留下来，是因为它和站点的气质贴得很近：冷一点、静一点，也还留着一丝微弱的光。',
		link: {
			href: '/origin/详情文章/名字来源/',
			label: '查看详情',
		},
	},
	{
		title: 'Dead Soul Insects 的意象',
		description:
			'“Dead Soul Insects”更接近一种意象，而不是完整设定。它能把夜色、残光、碎片和缓慢整理中的内容放进同一条语气里。',
	},
];

const base = import.meta.env.BASE_URL;
---

<Layout title="起源 | Dead Soul Insects" description="解释 Dead Soul Insects 的名字来源、死魂虫意象与站点视觉选择。" canonicalPath="/origin/">
	<div class="editorial-page origin-page">
		<section class="intro intro--single">
			<div class="intro-grid">
				<div class="intro-copy">
					<p class="kicker">起源</p>
					<h1>这个名字留下了一种冷静的语气</h1>
					<p class="lead">Dead Soul Insects 不是完整设定，更像给这个站点定下的气息：安静、偏冷，留一点微光。</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="origin-title">
			<header class="section-heading">
				<span class="section-index">01 / ORIGIN</span>
				<div class="section-copy">
					<p class="kicker">说明</p>
					<h2 id="origin-title">这一页只解释它为什么合适</h2>
					<p class="section-note">想知道这个名字从哪里来，可以从这里开始；剩下的部分留给读者自己感受。</p>
				</div>
			</header>

			<div class="editorial-stack">
				{originSections.map((section, index) => (
					<article class="editorial-row">
						<span class="editorial-row-index">{String(index + 1).padStart(2, '0')}</span>
						<div>
							<h3>{section.title}</h3>
							<p>{section.description}</p>
							{section.link && (
								<a class="arrow-link" href={withBase(base, section.link.href)}>
									{section.link.label} <span aria-hidden="true">→</span>
								</a>
							)}
						</div>
					</article>
				))}
			</div>

			<div class="aftertone">
				<p class="kicker">AFTERTONE</p>
				<h2>保留一点模糊感</h2>
				<p>不必把每个意象都说尽。只要它还能让人感到安静、冷调和一点微光，这个名字就成立。</p>
			</div>
		</section>
	</div>
</Layout>
