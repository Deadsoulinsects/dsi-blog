---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../utils/paths';

const otherOrigins = [
	{
		title: '《犬夜叉》',
		href: '/origin/详情文章/《犬夜叉》/',
	},
	{
		title: '优化',
		href: '/origin/详情文章/优化/',
	},
];

const base = import.meta.env.BASE_URL;
---

<Layout title="起源 | Dead Soul Insects" description="Dead Soul Insects 的名字来自《犬夜叉》中的死魂虫。阅读名字来源与命名经过。" canonicalPath="/origin/">
	<div class="origin-page">
		<h1>起源</h1>
		<section class="origin-story" aria-labelledby="origin-name">
			<h2 id="origin-name">Dead Soul Insects</h2>
			<p>名字来自《犬夜叉》中的“死魂虫”，也就是桔梗身边收集死魂的妖怪。</p>
			<p>《犬夜叉》是我很稚嫩时看的第一部动漫。重新取名时，我想到了死魂虫；后来为电脑用户文件夹选择英文名，最终采用了复数形式。</p>
			<a class="origin-read" href={withBase(base, '/origin/详情文章/名字来源/')}>
				阅读名字来源 <span aria-hidden="true">→</span>
			</a>
		</section>
		<section class="origin-other" aria-labelledby="other-origins">
			<h2 id="other-origins">其他起源条目</h2>
			<ul>
				{otherOrigins.map((entry) => (
					<li>
						<a href={withBase(base, entry.href)}>{entry.title}</a>
						<span>暂无正文</span>
					</li>
				))}
			</ul>
		</section>
	</div>
</Layout>

<style>
	.origin-page {
		margin-inline: auto;
		padding-block-start: var(--space-4);
		overflow-wrap: anywhere;
	}

	h1 {
		margin: 0 0 var(--space-7);
		font-family: var(--font-reading);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.origin-story h2 {
		margin: 0 0 var(--space-5);
		font-family: var(--font-reading);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 500;
		line-height: 1.3;
		text-wrap: balance;
	}

	.origin-story p {
		margin: 0 0 var(--space-4);
		font-size: var(--text-body);
		line-height: 1.85;
	}

	.origin-story p + p {
		color: var(--text-soft);
	}

	.origin-page a {
		color: var(--accent-soft);
		text-underline-offset: var(--space-1);
		text-decoration-thickness: var(--rule-thin);
	}

	.origin-page a:is(:hover, :focus-visible) {
		color: var(--text);
	}

	.origin-read {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-block-size: 2.75rem;
		margin-block-start: var(--space-2);
		line-height: 1.6;
	}

	.origin-other {
		margin-block-start: var(--space-8);
		padding-block-start: var(--space-5);
		border-block-start: var(--rule-thin) solid var(--line);
	}

	.origin-other h2 {
		margin: 0 0 var(--space-3);
		color: var(--text-soft);
		font-size: var(--text-body);
		font-weight: 500;
		line-height: 1.6;
	}

	.origin-other ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.origin-other li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2) var(--space-5);
	}

	.origin-other a {
		padding-block: var(--space-3);
		line-height: 1.6;
	}

	.origin-other span {
		color: var(--text-soft);
		font-size: var(--text-note);
		line-height: 1.6;
	}

	@media (max-width: 760px) {
		h1 {
			margin-block-end: var(--space-6);
		}

		.origin-other {
			margin-block-start: var(--space-7);
		}
	}
</style>
