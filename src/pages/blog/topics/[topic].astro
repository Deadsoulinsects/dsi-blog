---
import Layout from '../../../layouts/Layout.astro';
import { formatDate, formatDateTime, getSortedPosts } from '../../../utils/content';
import { withBase } from '../../../utils/paths';
import { getTopicGroups } from '../../../utils/topics';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	const topicGroups = getTopicGroups(posts);

	return topicGroups.map((topicGroup) => ({
		params: { topic: topicGroup.slug },
		props: { topicGroup },
	}));
}

const { topicGroup } = Astro.props;
const base = import.meta.env.BASE_URL;
const sortedPosts = [...topicGroup.posts].sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime());
const pageDescription = topicGroup.description ?? `查看 ${topicGroup.name} 专题下的博客文章。`;
---

<Layout title={`${topicGroup.name} | 专题 | Dead Soul Insects`} description={pageDescription} canonicalPath={`/blog/topics/${topicGroup.slug}/`}>
	<div class="page-shell">
		<section class="page-card intro-card">
			<a class="back-link" href={withBase(base, '/blog')}>← 返回博客列表</a>

			<header class="page-intro">
				<div class="intro-copy">
					<p class="kicker">专题</p>
					<h1>{topicGroup.name}</h1>
					{topicGroup.description && <p class="lead">{topicGroup.description}</p>}
				</div>

				<div class="intro-index">
					<div class="intro-index-item">
						<span class="index-label">专题文章</span>
						<strong>{topicGroup.posts.length}</strong>
					</div>
				</div>
			</header>

			<div class="intro-meta">
				<div class="intro-note">
					<p>这组内容已经形成稳定线索，适合顺着同一条主题继续往下看。</p>
				</div>
				<button class="time-sort-button" type="button" data-sort-toggle aria-label="按时间排序，当前为旧到新" aria-pressed="true">
					<span class="index-label">时间顺序</span>
					<span class="arrow" data-sort-arrow>↑</span>
				</button>
			</div>
		</section>

		<section class="page-card section-card" aria-label={`${topicGroup.name} 专题文章列表`}>
			<div class="section-heading">
				<div class="section-copy">
					<p class="kicker">文章</p>
					<h2>继续沿着这条线往下读</h2>
				</div>
				<p class="section-note">条目按时间展开，你可以切换顺序，但阅读路径仍然保持稳定。</p>
			</div>

			<div class="post-list" data-post-list>
			{sortedPosts.map((post) => (
				<a class="post-card" href={withBase(base, `/blog/${post.id}/`)} data-date={formatDateTime(post.data.pubDate)}>
					<div class="post-meta">
						<time class="post-date" datetime={formatDateTime(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
						<span class="meta-index-label">专题文章</span>
					</div>
					<div class="post-card-body">
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
					</div>
				</a>
			))}
			</div>
		</section>
	</div>
</Layout>

<script>
	const postList = document.querySelector<HTMLElement>('[data-post-list]');
	const sortButton = document.querySelector<HTMLButtonElement>('[data-sort-toggle]');
	const sortArrow = document.querySelector<HTMLElement>('[data-sort-arrow]');
	let ascending = true;

	const applySort = () => {
		if (!postList) {
			return;
		}

		Array.from(postList.querySelectorAll<HTMLElement>('[data-date]'))
			.sort((a, b) => {
				const first = new Date(a.dataset.date ?? '').getTime();
				const second = new Date(b.dataset.date ?? '').getTime();

				return ascending ? first - second : second - first;
			})
			.forEach((card) => postList.appendChild(card));

		if (sortArrow) {
			sortArrow.textContent = ascending ? '↑' : '↓';
		}

		sortButton?.setAttribute('aria-label', `按时间排序，当前为${ascending ? '旧到新' : '新到旧'}`);
		sortButton?.setAttribute('aria-pressed', ascending ? 'true' : 'false');
	};

	sortButton?.addEventListener('click', () => {
		ascending = !ascending;
		applySort();
	});

	applySort();
</script>

<style>
	.page-shell {
		display: grid;
		gap: clamp(22px, 2.8vw, 30px);
	}

	.page-card,
		.post-card {
		border: 1px solid var(--line);
		backdrop-filter: var(--glass-blur);
		box-sizing: border-box;
	}

	.page-card {
		padding: clamp(24px, 3.4vw, 34px);
		border-radius: var(--radius-panel);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)),
			var(--panel);
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22);
		overflow: clip;
	}

	.page-intro,
		.intro-copy,
		.section-copy,
		.post-card-body,
		.intro-card,
		.section-card {
		display: grid;
		gap: 12px;
	}

	.page-intro {
		grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.7fr);
		align-items: start;
		gap: 24px;
	}

	.intro-copy {
		max-width: 40rem;
	}

	.back-link,
	.time-sort-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		justify-self: start;
		min-height: 28px;
		padding: 5px 10px;
		border-radius: var(--radius-pill);
		font-size: 0.82rem;
	}

	.back-link,
	.time-sort-button {
		border: 1px solid rgba(153, 176, 255, 0.16);
		background: rgba(255, 255, 255, 0.045);
		color: var(--text-soft);
		text-decoration: none;
	}

	.intro-index {
		display: grid;
		grid-template-columns: 1fr;
		gap: 12px;
		align-content: start;
	}

	.intro-index-item {
		display: grid;
		gap: 8px;
		padding: 16px 18px;
		border: 1px solid rgba(153, 176, 255, 0.14);
		border-radius: 20px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.022), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel-strong) 84%, transparent);
		box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
	}

	.intro-index-item strong {
		font-size: 1.05rem;
		line-height: 1;
		color: var(--text);
	}

	.back-link {
		margin-bottom: 20px;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.back-link:is(:hover, :focus-visible) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background: rgba(157, 140, 255, 0.14);
		color: var(--text);
	}

	.back-link:focus-visible,
	.time-sort-button:focus-visible,
	.post-card:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-offset);
	}

	.intro-meta {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 16px;
		align-items: start;
	}

	.intro-note {
		padding-top: 2px;
		border-top: 1px solid rgba(153, 176, 255, 0.12);
	}

	.kicker {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.index-label,
	.meta-index-label {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-soft);
	}

	h1,
	h2,
	strong,
	p,
	time,
	span {
		margin: 0;
		overflow-wrap: anywhere;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
	}

	h2 {
		font-size: clamp(1.2rem, 2.2vw, 1.5rem);
		line-height: 1.24;
	}

	p,
	time {
		color: var(--text-soft);
		line-height: 1.78;
	}

	.lead {
		font-size: 1.02rem;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
		gap: 14px;
		align-items: end;
	}

	.section-copy {
		gap: 8px;
	}

	.section-note {
		max-width: 36rem;
		align-self: end;
	}

	.time-sort-button {
		gap: 8px;
		font: inherit;
		cursor: pointer;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.time-sort-button .arrow {
		color: var(--accent-soft);
	}

	.time-sort-button:is(:hover, :focus-visible) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background: rgba(157, 140, 255, 0.14);
		color: var(--text);
	}

	.post-list {
		display: grid;
		gap: 14px;
	}

	.post-card {
		padding: 20px 22px;
		border-radius: 20px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.024), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel) 90%, var(--bg));
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
		color: inherit;
		text-decoration: none;
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: 20px;
		transition:
			transform 0.18s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	.post-card-body {
		min-width: 0;
	}

	.post-meta {
		display: grid;
		gap: 8px;
		justify-items: start;
		text-align: left;
		flex-shrink: 0;
	}

	.post-date {
		font-size: 0.9rem;
		color: var(--text);
		line-height: 1.5;
	}

	.post-card:is(:hover, :focus-visible) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel-strong) 90%, var(--bg));
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.16);
	}

	@media (max-width: 960px) {
		.page-intro,
		.section-heading,
		.intro-meta,
		.post-card {
			grid-template-columns: 1fr;
		}

		.post-card {
			display: grid;
		}
	}

	@media (max-width: 640px) {
		.post-card {
			padding: 18px;
		}
	}
</style>
