---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ArticleMedia from '../../components/ArticleMedia.astro';
import { render } from 'astro:content';
import { formatDate, formatDateTime, getSortedPosts } from '../../utils/content';
import { withBase } from '../../utils/paths';
import { getTopicPath, getTopicSlug } from '../../utils/topics';

export async function getStaticPaths() {
	const posts = await getSortedPosts();

	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			post,
		},
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const dateLabel = formatDate(post.data.completion_date);
const dateTime = formatDateTime(post.data.completion_date);
const base = import.meta.env.BASE_URL;
const topicPath = getTopicPath(post.data);
const topic = topicPath.at(-1);
const backHref = topic ? withBase(base, `/blog/topics/${getTopicSlug(topicPath)}/`) : withBase(base, '/blog');
const backLabel = topic ? `返回${topic}专题` : '返回博客列表';
---

<ArticleLayout
	title={post.data.title}
	description={post.data.description}
	sectionLabel="文章"
	backHref={backHref}
	backLabel={backLabel}
	dateLabel={dateLabel}
	dateTime={dateTime}
	dateKind="完成日期"
	startDate={post.data.start_date ? formatDateTime(post.data.start_date) : undefined}
	endDate={post.data.end_date ? formatDateTime(post.data.end_date) : undefined}
	headings={headings}
	canonicalPath={`/blog/${post.id}/`}
	publishedTime={post.data.completion_date.toISOString()}
>
	{topicPath.length > 0 && (
		<nav slot="topic-navigation" class="article-topic-path" aria-label="文章专题路径">
			{topicPath.map((name, index) => (
				<>
					{index > 0 && <span aria-hidden="true">/</span>}
					<a href={withBase(base, `/blog/topics/${getTopicSlug(topicPath.slice(0, index + 1))}/`)}>{name}</a>
				</>
			))}
		</nav>
	)}
	{post.data.mediaId && <ArticleMedia />}
	<Content />
</ArticleLayout>

<style>
	.article-topic-path {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-3);
		margin-bottom: var(--space-4);
		color: var(--text-soft);
		font-size: var(--text-small);
	}
	.article-topic-path a {
		color: var(--accent-soft);
		overflow-wrap: anywhere;
	}
</style>
