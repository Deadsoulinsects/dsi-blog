---
import Layout from '../../layouts/Layout.astro';
import { getAllDocCategories } from '../../utils/content';
import { withBase } from '../../utils/paths';

const categories = await getAllDocCategories();
const base = import.meta.env.BASE_URL;
---

<Layout title="文档分类 | Dead Soul Insects" description="按分类查阅 Dead Soul Insects 的公开文档。" canonicalPath="/categories/" mainId="categories-main" skipLinkLabel="跳到文档分类">
	<div class="category-catalog">
		<header class="catalog-heading">
			<h1>文档分类</h1>
			<a class="catalog-all" href={withBase(base, '/docs/')}>全部文档 →</a>
		</header>
		<nav aria-label="文档分类">
			{categories.length ? (
				<ul class="category-list" role="list">
					{categories.map((category) => (
						<li>
							<a class="category-link" href={withBase(base, `/categories/${category.slug}/`)}>
								<span class="category-name">{category.name}</span>
								<span class="category-count">{category.count} 篇文档</span>
								<span class="category-arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))}
				</ul>
			) : <p class="catalog-empty">暂无公开文档分类。</p>}
		</nav>
	</div>
</Layout>

<style>
	:global(#categories-main) {
		scroll-margin-block-start: calc(var(--space-8) + var(--space-7));
	}
	.category-catalog {
		padding-top: var(--space-7);
	}
	.catalog-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-4) var(--space-6);
		margin-bottom: var(--space-8);
	}
	.catalog-heading h1 {
		margin: 0;
		min-width: 0;
		color: var(--text);
		font-family: var(--font-reading);
		font-size: var(--text-section);
		font-weight: 500;
		line-height: 1.2;
	}
	.catalog-all {
		color: var(--text-soft);
		font-size: var(--text-small);
		text-underline-offset: var(--space-1);
	}
	.category-list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-8);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.category-list li {
		flex: 0 1 18rem;
		min-width: 0;
	}
	.category-link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto auto;
		align-items: baseline;
		gap: var(--space-3);
		min-height: var(--space-7);
		padding-block: var(--space-4);
		color: var(--text);
		text-decoration: none;
	}
	.category-name {
		font-family: var(--font-reading);
		font-size: var(--text-row);
		line-height: 1.3;
		overflow-wrap: anywhere;
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-decoration-thickness: var(--rule-thin);
		text-underline-offset: var(--space-1);
	}
	.category-count {
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-small);
		line-height: 1.6;
		white-space: nowrap;
	}
	.category-arrow {
		color: var(--accent-soft);
		font-size: var(--text-body);
	}
	.catalog-all:is(:hover, :focus-visible),
	.category-link:is(:hover, :focus-visible) .category-name {
		color: var(--accent-soft);
		text-decoration-color: currentColor;
	}
	.catalog-empty {
		margin: 0;
		color: var(--text-soft);
		font-size: var(--text-body);
		line-height: 1.75;
	}
	@media (max-width: 760px) {
		.category-catalog {
			padding-top: var(--space-6);
		}
	}
</style>
