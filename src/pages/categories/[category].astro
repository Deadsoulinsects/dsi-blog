---
import Layout from '../../layouts/Layout.astro';
import { formatDateTime, getAllDocCategories, getSortedDocs } from '../../utils/content';
import { toParamSlug, withBase } from '../../utils/paths';

export async function getStaticPaths() {
	const categories = await getAllDocCategories();
	return categories.map((category) => ({
		params: { category: category.slug },
		props: { categoryName: category.name },
	}));
}

const { categoryName } = Astro.props;
const docs = (await getSortedDocs()).filter((doc) => toParamSlug(doc.data.category) === toParamSlug(categoryName));
const base = import.meta.env.BASE_URL;
---

<Layout title={`${categoryName} | 文档分类 | Dead Soul Insects`} description={`${categoryName} 分类下的公开文档。`} canonicalPath={`/categories/${toParamSlug(categoryName)}/`} mainId="categories-main" skipLinkLabel="跳到分类文档">
	<div class="category-reading">
		<header>
			<nav class="category-path" aria-label="文档路径">
				<a href={withBase(base, '/docs/')}>文档</a>
				<span aria-hidden="true">/</span>
				<a href={withBase(base, '/categories/')}>分类</a>
			</nav>
			<div class="category-heading">
				<h1>{categoryName}</h1>
				<span class="category-total">{docs.length} 篇文档</span>
			</div>
		</header>

		<section aria-label={`${categoryName} 分类下的文档`}>
			<ul class="category-docs" role="list">
				{docs.map((doc) => {
					const description = doc.data.description.trim();
					const dateTime = formatDateTime(doc.data.pubDate);
					return (
						<li>
							<h2>
								<a class="category-doc-title" href={withBase(base, `/docs/${doc.id}/`)}>
									<span class="category-doc-name">{doc.data.title}</span>
									<span class="category-doc-arrow" aria-hidden="true">→</span>
								</a>
							</h2>
							{description && <p class="category-doc-description">{description}</p>}
							<p class="category-doc-date">发布于 <time datetime={dateTime}>{dateTime}</time></p>
						</li>
					);
				})}
			</ul>
		</section>
	</div>
</Layout>

<style>
	:global(#categories-main) {
		scroll-margin-block-start: calc(var(--space-8) + var(--space-7));
	}
	.category-reading {
		max-width: var(--list-measure);
		padding-top: var(--space-7);
	}
	.category-path {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		color: var(--text-soft);
		font-size: var(--text-small);
		line-height: 1.6;
	}
	.category-path a {
		text-underline-offset: var(--space-1);
	}
	.category-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: baseline;
		gap: var(--space-3) var(--space-5);
		margin: var(--space-5) 0 var(--space-6);
	}
	.category-heading h1 {
		min-width: 0;
		margin: 0;
		color: var(--text);
		font-family: var(--font-reading);
		font-size: var(--text-section);
		font-weight: 500;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}
	.category-total {
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-small);
		line-height: 1.6;
		white-space: nowrap;
	}
	.category-docs {
		display: grid;
		gap: var(--space-6);
		max-width: var(--reading-measure);
		margin: 0;
		padding: var(--space-5);
		list-style: none;
	}
	.category-docs li,
	.category-docs h2 {
		min-width: 0;
		margin: 0;
	}
	.category-doc-title {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		gap: var(--space-4);
		padding-block: var(--space-2);
		color: var(--text);
		font-family: var(--font-reading);
		font-size: var(--text-row);
		font-weight: 500;
		line-height: 1.3;
		text-decoration: none;
	}
	.category-doc-name {
		overflow-wrap: anywhere;
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-decoration-thickness: var(--rule-thin);
		text-underline-offset: var(--space-1);
	}
	.category-doc-arrow {
		color: var(--accent-soft);
		font-family: var(--font-ui);
		font-size: var(--text-body);
		line-height: 1.75;
	}
	.category-doc-description {
		margin: var(--space-2) 0 0;
		color: var(--text-soft);
		font-size: var(--text-body);
		line-height: 1.75;
		overflow-wrap: anywhere;
	}
	.category-doc-date {
		margin: var(--space-3) 0 0;
		color: var(--text-soft);
		font-size: var(--text-small);
		line-height: 1.6;
	}
	.category-doc-date time {
		font-family: var(--font-meta);
		font-variant-numeric: tabular-nums lining-nums;
		white-space: nowrap;
	}
	.category-path a:is(:hover, :focus-visible),
	.category-doc-title:is(:hover, :focus-visible) .category-doc-name {
		color: var(--accent-soft);
		text-decoration-color: currentColor;
	}
	@media (max-width: 760px) {
		.category-reading {
			padding-top: var(--space-6);
		}
		.category-heading {
			grid-template-columns: minmax(0, 1fr);
		}
		.category-docs {
			padding: var(--space-4) 0;
		}
	}
</style>
