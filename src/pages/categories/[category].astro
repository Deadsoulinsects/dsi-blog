---
import Layout from '../../layouts/Layout.astro';
import { formatDate, formatDateTime, getAllDocCategories, getSortedDocs } from '../../utils/content';
import { toParamSlug, withBase } from '../../utils/paths';

export async function getStaticPaths() {
	const categories = await getAllDocCategories();

	return categories.map((category) => ({
		params: { category: category.slug },
		props: { categoryName: category.name },
	}));
}

const { categoryName } = Astro.props;
const docs = (await getSortedDocs()).filter((doc) => toParamSlug(doc.data.category) === toParamSlug(categoryName));
const base = import.meta.env.BASE_URL;
---

<Layout title={`${categoryName} | 分类 | Dead Soul Insects`} description={`按分类查看 ${categoryName} 文档。`} canonicalPath={`/categories/${toParamSlug(categoryName)}/`}>
	<div class="page-shell">
		<section class="page-card intro-card">
			<a class="back-link" href={withBase(base, '/categories/')}>← 返回分类入口</a>

			<header class="page-intro">
				<p class="kicker">分类</p>
				<h1>{categoryName}</h1>
				<p class="lead">这里收纳属于该分类的文档页面，适合从一个明确主题开始集中查看。</p>
			</header>

			<div class="intro-meta" aria-label="当前分类概览">
				<span class="meta-pill">{docs.length} 篇文档</span>
			</div>
		</section>

		<section class="item-list" aria-label="分类文档列表">
			{docs.map((doc) => (
				<a class="item-card" href={withBase(base, `/docs/${doc.id}/`)}>
					<div class="item-card-top">
						<time class="item-date" datetime={formatDateTime(doc.data.pubDate)}>{formatDate(doc.data.pubDate)}</time>
					</div>
					<div class="item-card-body">
						<h2>{doc.data.title}</h2>
						<p>{doc.data.description}</p>
					</div>
					<span class="item-link">打开文档 →</span>
				</a>
			))}
		</section>
	</div>
</Layout>

<style>
	.page-shell {
		display: grid;
		gap: 22px;
	}

	.page-card,
	.item-card {
		border: 1px solid var(--line);
		backdrop-filter: var(--glass-blur);
	}

	.page-card {
		padding: clamp(26px, 4vw, 40px);
		border-radius: var(--radius-panel);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)),
			var(--panel);
		box-shadow: var(--shadow);
	}

	.page-intro,
	.item-card-body {
		display: grid;
		gap: 12px;
	}

	.page-intro {
		max-width: 52rem;
	}

	.back-link,
	.meta-pill,
	.item-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		justify-self: start;
		min-height: 28px;
		padding: 5px 10px;
		border-radius: var(--radius-pill);
		font-size: 0.82rem;
		text-decoration: none;
	}

	.back-link,
	.item-link {
		border: 1px solid rgba(153, 176, 255, 0.16);
		background: rgba(255, 255, 255, 0.045);
		color: var(--text-soft);
	}

	.meta-pill {
		border: 1px solid var(--tag-border);
		background: var(--tag-bg);
		color: var(--accent-soft);
	}

	.back-link {
		margin-bottom: 20px;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.back-link:is(:hover, :focus-visible) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background: rgba(157, 140, 255, 0.14);
		color: var(--text);
	}

	.back-link:focus-visible,
	.item-card:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-offset);
	}

	.intro-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-top: 20px;
	}

	.kicker {
		margin: 0;
		font-size: 0.88rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	h1,
	h2,
	p,
	time,
	span {
		margin: 0;
		overflow-wrap: anywhere;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
	}

	h2 {
		font-size: clamp(1.2rem, 2.2vw, 1.5rem);
		line-height: 1.24;
	}

	p,
	time {
		color: var(--text-soft);
		line-height: 1.78;
	}

	.lead {
		font-size: 1.02rem;
	}

	.item-list {
		display: grid;
		gap: 18px;
	}

	.item-card {
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: 18px;
		padding: 24px;
		border-radius: var(--radius-card);
		background:
			radial-gradient(circle at top right, rgba(110, 195, 255, 0.08), transparent 34%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)),
			var(--panel);
		box-shadow: var(--shadow-soft);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	.item-card-top {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: start;
		gap: 12px;
	}

	.item-date {
		font-size: 0.9rem;
		color: var(--accent-soft);
	}

	.item-card:is(:hover, :focus-visible) {
		transform: translateY(-2px);
		border-color: var(--hover-border);
		background:
			radial-gradient(circle at top right, rgba(110, 195, 255, 0.14), transparent 36%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
			var(--panel-strong);
		box-shadow: var(--shadow-hover);
	}

	@media (max-width: 640px) {
		.item-card {
			padding: 22px;
		}
	}
</style>
