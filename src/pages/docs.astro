---
import Layout from '../layouts/Layout.astro';
import { formatDateTime, getSortedDocs } from '../utils/content';
import { withBase } from '../utils/paths';

const docs = await getSortedDocs();
const base = import.meta.env.BASE_URL;
---

<Layout
	title="文档 | Dead Soul Insects"
	description="Dead Soul Insects 的公开文档与使用说明。"
	canonicalPath="/docs/"
	mainId="docs-main"
	skipLinkLabel="跳到文档内容"
>
	<div class="docs-page">
		<header class="docs-heading">
			<h1>文档</h1>
		</header>

		<section aria-label="文档目录">
			<ul class="docs-list">
				{docs.map((doc) => {
					const dateTime = formatDateTime(doc.data.pubDate);
					const category = doc.data.category.trim();
					const description = doc.data.description.trim();

					return (
						<li>
							<a class="doc-link" href={withBase(base, `/docs/${doc.id}/`)}>
								<div class="doc-copy">
									<h2 class="doc-title">{doc.data.title}</h2>
									{description && <p class="doc-description">{description}</p>}
									<p class="doc-meta">
										{category && <span class="doc-category">{category}</span>}
										<span class="doc-date">发布于 <time datetime={dateTime}>{dateTime}</time></span>
									</p>
								</div>
								<span class="doc-arrow" aria-hidden="true">→</span>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	</div>
</Layout>

<style>
	.docs-page {
		max-width: 100%;
		padding-top: var(--space-7);
	}

	.docs-heading {
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-5);
		border-bottom: var(--rule-thin) solid var(--line);
	}

	.docs-heading h1 {
		margin: 0;
		color: var(--text);
		font-family: var(--font-reading);
		font-size: var(--text-section);
		font-weight: 500;
		line-height: 1.2;
	}

	.docs-list {
		display: grid;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.doc-link {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: start;
		gap: var(--space-5);
		padding: var(--space-5);
		color: var(--text);
		text-decoration: none;
	}

	.doc-copy {
		min-width: 0;
	}

	.doc-title {
		margin: 0;
		font-family: var(--font-reading);
		font-size: var(--text-row);
		font-weight: 500;
		line-height: 1.3;
		overflow-wrap: anywhere;
		text-decoration: underline;
		text-decoration-color: var(--line);
		text-decoration-thickness: var(--rule-thin);
		text-underline-offset: var(--space-1);
	}

	.doc-description {
		max-width: var(--reading-measure);
		margin: var(--space-3) 0 0;
		color: var(--text-soft);
		font-size: var(--text-body);
		line-height: 1.75;
		overflow-wrap: anywhere;
	}

	.doc-meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
		margin: var(--space-4) 0 0;
		color: var(--text-soft);
		font-size: var(--text-small);
		line-height: 1.6;
	}

	.doc-category {
		overflow-wrap: anywhere;
	}

	.doc-date {
		white-space: nowrap;
	}

	.doc-date time {
		font-family: var(--font-meta);
		font-variant-numeric: tabular-nums lining-nums;
	}

	.doc-arrow {
		color: var(--accent-soft);
		font-size: var(--text-body);
		line-height: 1.75;
	}

	.doc-link:is(:hover, :focus-visible) {
		background: color-mix(in srgb, var(--panel) 42%, transparent);
	}

	.doc-link:is(:hover, :focus-visible) .doc-title {
		color: var(--accent-soft);
		text-decoration-color: currentColor;
	}

	@media (max-width: 760px) {
		.docs-page {
			padding-top: var(--space-6);
		}

		.docs-heading {
			margin-bottom: var(--space-5);
		}

		.doc-link {
			gap: var(--space-3);
			padding: var(--space-4) 0;
		}
	}
</style>
