---
import Layout from '../layouts/Layout.astro';
import { formatDateTime, getSortedDocs } from '../utils/content';
import { withBase } from '../utils/paths';

const docs = await getSortedDocs();
const base = import.meta.env.BASE_URL;
---

<Layout title="文档 | Dead Soul Insects" description="Dead Soul Insects 的文档列表页，整理分享文档、学习资料与配置说明。" canonicalPath="/docs/">
	<div class="editorial-page docs-page">
		<section class="intro">
			<div class="intro-grid">
				<div>
					<p class="kicker">文档</p>
					<h1>把零散记录收紧成可复用的说明</h1>
				</div>

				<div class="intro-side">
					<p class="lead">
						博客偏向持续写下来的过程，文档页更偏向整理后的结果。这里直接列出当前可读的说明页，方便查阅，也方便在需要时重新打开。
					</p>

					<div class="intro-index" aria-label="文档概览">
						<div class="intro-stat">
							<span>公开文档</span>
							<strong>{docs.length}</strong>
						</div>
						<div class="intro-stat">
							<span>浏览方式</span>
							<strong class="browse-mode">按清单</strong>
						</div>
					</div>

					<p class="intro-note">这里优先保留已经整理成说明的页面，适合在需要时直接重新打开，不必再从博客过程里回找。</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="docs-index-title">
			<header class="section-heading">
				<span class="section-index">01 / INDEX</span>
				<div class="section-copy">
					<p class="kicker">索引</p>
					<h2 id="docs-index-title">按整理后的说明进入</h2>
					<p class="section-note">每条文档保留标题、摘要与更新时间，先缩小目标，再进入具体页面。</p>
				</div>
			</header>

			<div class="rule-list">
				{docs.map((doc) => {
					const dateTime = formatDateTime(doc.data.pubDate);
					const category = doc.data.category.trim();

					return (
						<a class="rule-row doc-row text-link" href={withBase(base, `/docs/${doc.id}/`)}>
							<div>
								<h3 class="doc-title">{doc.data.title}</h3>
								<p class="doc-description">{doc.data.description}</p>
							</div>

							<div class="doc-meta">
								<time datetime={dateTime}>{dateTime.replaceAll('-', '.')}</time>
								{category && <span>{category}</span>}
							</div>
						</a>
					);
				})}
			</div>
		</section>
	</div>
</Layout>

<style>
	.browse-mode {
		padding-top: var(--space-1);
		font-family: var(--font-ui);
		font-size: var(--text-body);
	}

	.doc-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) var(--column-doc-meta);
		gap: var(--space-6);
	}

	.doc-row > div {
		min-width: 0;
	}

	.doc-title {
		font-family: var(--font-reading);
		font-size: var(--text-editorial-row);
		font-weight: 500;
		line-height: 1.18;
		letter-spacing: var(--tracking-row);
	}

	.doc-description {
		max-width: var(--list-measure);
		margin-top: var(--space-3);
		color: var(--text-soft);
		line-height: 1.7;
	}

	.doc-meta {
		display: grid;
		justify-items: end;
		align-content: start;
		gap: var(--space-2);
		color: var(--text-soft);
		font-family: var(--font-meta);
		font-size: var(--text-meta);
		text-align: right;
	}

	.doc-meta time {
		letter-spacing: var(--tracking-date);
		font-variant-numeric: tabular-nums lining-nums;
	}

	@media (max-width: 760px) {
		.doc-row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-3);
		}

		.doc-meta {
			justify-items: start;
			text-align: left;
		}
	}
</style>
