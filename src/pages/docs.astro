---
import Layout from '../layouts/Layout.astro';
import { formatDate, formatDateTime, getSortedDocs } from '../utils/content';
import { withBase } from '../utils/paths';

const docs = await getSortedDocs();
const base = import.meta.env.BASE_URL;
---

<Layout title="文档 | Dead Soul Insects" description="Dead Soul Insects 的文档列表页，整理分享文档、学习资料与配置说明。" canonicalPath="/docs/">
	<div class="page-shell">
		<section class="page-card intro-card">
			<header class="page-intro">
				<div class="intro-copy">
					<p class="kicker">文档</p>
					<h1>把零散记录收紧成可复用的说明</h1>
					<p class="lead">
						博客偏向持续写下来的过程，文档页更偏向整理后的结果。这里直接列出当前可读的说明页，方便查阅，也方便在需要时重新打开。
					</p>
				</div>

				<div class="intro-index" aria-label="文档概览">
					<div class="intro-index-item">
						<span class="index-label">公开文档</span>
						<strong>{docs.length}</strong>
					</div>
					<div class="intro-index-item muted">
						<span class="index-label">浏览方式</span>
						<strong>按清单</strong>
					</div>
				</div>
			</header>

			<div class="intro-note">
				<p>这里优先保留已经整理成说明的页面，适合在需要时直接重新打开，不必再从博客过程里回找。</p>
			</div>
		</section>

		<section class="page-card section-card" aria-label="文档列表">
			<div class="section-heading">
				<div class="section-copy">
					<p class="kicker">索引</p>
					<h2>按整理后的说明进入</h2>
				</div>
				<p class="section-note">每条文档保留标题、摘要与更新时间，先缩小目标，再进入具体页面。</p>
			</div>

			<div class="doc-list">
				{docs.map((doc) => (
					<a class="doc-card" href={withBase(base, `/docs/${doc.id}/`)}>
						<div class="doc-card-body">
							<h3>{doc.data.title}</h3>
							<p class="doc-description">{doc.data.description}</p>
						</div>
						<div class="doc-meta">
							<time class="doc-date" datetime={formatDateTime(doc.data.pubDate)}>{formatDate(doc.data.pubDate)}</time>
							<span class="meta-index-label">打开文档</span>
						</div>
					</a>
				))}
			</div>
		</section>
	</div>
</Layout>

<style>
	.page-shell {
		display: grid;
		gap: clamp(22px, 2.8vw, 30px);
	}

	.page-card,
		.doc-card {
		border: 1px solid var(--line);
		backdrop-filter: var(--glass-blur);
		box-sizing: border-box;
	}

	.page-card {
		padding: clamp(24px, 3.4vw, 34px);
		border-radius: var(--radius-panel);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)),
			var(--panel);
		box-shadow: 0 18px 42px rgba(0, 0, 0, 0.22);
		overflow: clip;
	}

	.page-intro,
		.intro-card,
		.section-card,
		.intro-copy,
		.section-copy,
		.doc-card-body {
		display: grid;
		gap: 12px;
	}

	.page-intro {
		grid-template-columns: minmax(0, 1.35fr) minmax(14rem, 0.7fr);
		align-items: start;
		gap: 24px;
	}

	.intro-card,
	.section-card {
		gap: 20px;
	}

	.intro-copy {
		max-width: 40rem;
	}

	.intro-index {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		align-content: start;
	}

	.intro-index-item {
		display: grid;
		gap: 8px;
		padding: 16px 18px;
		border: 1px solid rgba(153, 176, 255, 0.14);
		border-radius: 20px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.022), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel-strong) 84%, transparent);
		box-shadow: 0 6px 14px rgba(0, 0, 0, 0.12);
	}

	.intro-index-item.muted {
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.018), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel) 88%, transparent);
	}

	.intro-index-item strong {
		font-size: 1.05rem;
		line-height: 1;
		color: var(--text);
	}

	.intro-note {
		padding-top: 2px;
		border-top: 1px solid rgba(153, 176, 255, 0.12);
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.8fr);
		gap: 14px;
		align-items: end;
	}

	.section-copy {
		gap: 8px;
	}

	.section-note {
		max-width: 36rem;
		align-self: end;
	}

	.kicker {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.index-label,
	.meta-index-label {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-soft);
	}

	h1,
	h2,
	h3,
	p,
	time,
	strong,
		span {
		margin: 0;
		overflow-wrap: anywhere;
	}

	h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
	}

	h2 {
		font-size: clamp(1.35rem, 2.5vw, 1.8rem);
		line-height: 1.16;
	}

	h3 {
		font-size: clamp(1.2rem, 2.2vw, 1.5rem);
		line-height: 1.24;
	}

	p,
	time {
		color: var(--text-soft);
		line-height: 1.78;
	}

	.lead {
		font-size: 1.02rem;
	}

	.doc-list {
		display: grid;
		gap: 14px;
	}

	.doc-card {
		padding: 20px 22px;
		border-radius: 20px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.024), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel) 90%, var(--bg));
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);
		color: inherit;
		text-decoration: none;
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: 20px;
		transition:
			transform 0.18s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	.doc-card-body {
		min-width: 0;
	}

	.doc-meta {
		display: grid;
		gap: 8px;
		justify-items: end;
		text-align: right;
		flex-shrink: 0;
	}

	.doc-date {
		font-size: 0.9rem;
		color: var(--text);
		line-height: 1.5;
	}

	.doc-description {
		max-width: 34rem;
	}

	.doc-card:is(:hover, :focus-visible) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel-strong) 90%, var(--bg));
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.16);
	}

	.doc-card:focus-visible {
		outline: var(--focus-ring);
		outline-offset: var(--focus-offset);
	}

	@media (max-width: 960px) {
		.page-intro,
		.section-heading,
		.doc-card,
		.intro-index {
			grid-template-columns: 1fr;
		}

		.doc-card {
			display: grid;
		}

		.doc-meta {
			justify-items: start;
			text-align: left;
		}
	}

	@media (max-width: 640px) {
		.page-card {
			padding: 20px;
		}

		.doc-card {
			padding: 18px;
		}
	}
</style>
