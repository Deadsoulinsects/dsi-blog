---
import Layout from '../../../layouts/Layout.astro';
import ListMasterView from '../../../components/ListMasterView.astro';
import { listMasterVariantMap, listMasterVariants } from '../../../data/listMasterVariants';
import { formatDate, getAllDocCategories, getArchiveGroups, getSortedPosts } from '../../../utils/content';
import { getTopicGroups } from '../../../utils/topics';

export async function getStaticPaths() {
	return listMasterVariants.map((variant) => ({
		params: { master: variant.slug },
		props: { masterSlug: variant.slug },
	}));
}

const { masterSlug } = Astro.props;
const variant = listMasterVariantMap.get(masterSlug);

if (!variant) {
	throw new Error(`Unknown list master: ${masterSlug}`);
}

const posts = await getSortedPosts();
const topics = getTopicGroups(posts).slice(0, 3).map((topic) => ({
	name: topic.name,
	description: topic.description,
	count: topic.posts.length,
	href: `/blog/topics/${topic.slug}/`,
}));

const postPreviews = posts.slice(0, 6).map((post) => ({
	title: post.data.title,
	description: post.data.description,
	dateLabel: formatDate(post.data.pubDate),
	topic: post.data.topic.trim() || undefined,
	href: `/blog/${post.id}/`,
}));

const categories = (await getAllDocCategories()).slice(0, 8).map((category) => ({
	name: category.name,
	count: category.count,
	href: `/categories/${category.slug}/`,
}));

const archiveGroups = (await getArchiveGroups()).slice(0, 3).map((group) => ({
	year: group.year,
	items: group.items.slice(0, 3).map((item) => ({
		title: item.data.title,
		dateLabel: formatDate(item.data.pubDate),
		href: `/blog/${item.id}/`,
	})),
}));

const base = import.meta.env.BASE_URL;
---

<Layout title={`${variant.name} | 第二轮母版探索 | Dead Soul Insects`} description={variant.thesis} canonicalPath={`/lab/list-masters/${variant.slug}/`} hideChrome={true}>
	<ListMasterView variant={variant} topics={topics} posts={postPreviews} categories={categories} archiveGroups={archiveGroups} base={base} />
</Layout>
