---
import Layout from './Layout.astro';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	title: string;
	description: string;
	sectionLabel: string;
	backHref: string;
	backLabel: string;
	dateLabel?: string;
	dateTime?: string;
	headings?: Heading[];
	canonicalPath?: string;
	publishedTime?: string;
}

const {
	title,
	description,
	sectionLabel,
	backHref,
	backLabel,
	dateLabel,
	dateTime,
	headings = [],
	canonicalPath,
	publishedTime,
} = Astro.props;

const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const hasToc = tocHeadings.length > 0;
const hasHeaderMeta = Boolean(dateLabel && dateTime) || hasToc;
const articleStructuredData = canonicalPath
	? {
			'@context': 'https://schema.org',
			'@type': 'Article',
			headline: title,
			description,
			datePublished: publishedTime,
			url: canonicalPath,
		}
	: null;
---

<Layout
	title={`${title} | Dead Soul Insects`}
	description={description}
	canonicalPath={canonicalPath}
	ogType="article"
	twitterTitle={`${title} | Dead Soul Insects`}
	twitterDescription={description}
>
	{articleStructuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleStructuredData)}></script>}
	<article class="article-shell">
		<header class="article-header">
			<a class="back-link" href={backHref}>← {backLabel}</a>
			<div class="article-heading">
				<div class="article-copy">
					<p class="kicker">{sectionLabel}</p>
					<h1>{title}</h1>
					<p class="article-description">{description}</p>
				</div>

				{hasHeaderMeta && (
					<div class="article-meta" aria-label="文章信息">
						{dateLabel && dateTime && (
							<div class="meta-index-item">
								<span class="meta-label">发布时间</span>
								<time datetime={dateTime}>{dateLabel}</time>
							</div>
						)}
						{hasToc && (
							<div class="meta-index-item muted">
								<span class="meta-label">目录章节</span>
								<strong>{tocHeadings.length}</strong>
							</div>
						)}
					</div>
				)}
			</div>
		</header>

		<div class:list={['article-grid', { 'has-toc': hasToc }]}>
			{hasToc && (
				<details class="toc-card" open>
					<summary>
						<span id="toc-title">目录</span>
						<span class="toc-count">{tocHeadings.length} 节</span>
					</summary>
					<div class="toc-panel" aria-labelledby="toc-title">
						<ul>
							{tocHeadings.map((heading) => (
								<li class:list={{ nested: heading.depth === 3 }}>
									<a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
								</li>
							))}
						</ul>
					</div>
				</details>
			)}

			<div class="article-body" id="article-body">
				<slot />
			</div>
		</div>

		<button class="back-to-top" id="back-to-top" type="button">返回顶部</button>
	</article>
</Layout>

<script>
	const articleBody = document.querySelector<HTMLElement>('#article-body');
	const backToTopButton = document.querySelector<HTMLButtonElement>('#back-to-top');
	const tocCard = document.querySelector<HTMLDetailsElement>('.toc-card');
	const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const mobileTocQuery = window.matchMedia('(max-width: 720px)');
	const tocTargets = tocLinks
		.map((link) => {
			const slug = decodeURIComponent(link.hash.slice(1));
			const target = document.getElementById(slug) ?? document.getElementById(link.hash.slice(1));

			return target ? { link, target } : null;
		})
		.filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => Boolean(item));
	let lockedTocLink: HTMLAnchorElement | null = null;
	let lockedTocTarget: HTMLElement | null = null;
	let unlockTocTimer = 0;

	const setActiveTocLink = (activeLink?: HTMLAnchorElement) => {
		for (const link of tocLinks) {
			const isActive = link === activeLink;

			link.classList.toggle('is-active', isActive);
			if (isActive) {
				link.setAttribute('aria-current', 'true');
			} else {
				link.removeAttribute('aria-current');
			}
		}
	};

	const getCurrentTocLink = () => {
		let activeLink = tocTargets[0]?.link;

		for (const item of tocTargets) {
			if (item.target.getBoundingClientRect().top <= 72) {
				activeLink = item.link;
			}
		}

		return activeLink;
	};

	const updateActiveTocLink = () => {
		if (lockedTocLink) {
			setActiveTocLink(lockedTocLink);
			return;
		}

		setActiveTocLink(getCurrentTocLink());
	};

	const unlockTocWhenSettled = () => {
		if (!lockedTocTarget) {
			return;
		}

		if (Math.abs(lockedTocTarget.getBoundingClientRect().top) <= 96) {
			lockedTocLink = null;
			lockedTocTarget = null;
			setActiveTocLink(getCurrentTocLink());
			return;
		}

		unlockTocTimer = window.setTimeout(unlockTocWhenSettled, 80);
	};

	const lockTocToTarget = (link: HTMLAnchorElement, target: HTMLElement) => {
		window.clearTimeout(unlockTocTimer);
		lockedTocLink = link;
		lockedTocTarget = target;
		setActiveTocLink(link);
		target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
		history.pushState(null, '', link.hash);
		unlockTocTimer = window.setTimeout(unlockTocWhenSettled, reduceMotion ? 0 : 160);

		window.setTimeout(() => {
			if (lockedTocLink === link) {
				lockedTocLink = null;
				lockedTocTarget = null;
				setActiveTocLink(getCurrentTocLink());
			}
		}, 1600);
	};

	let tocAnimationFrame = 0;
	let userChangedTocState = false;
	let syncingTocState = false;

	const syncTocStateForViewport = () => {
		if (!tocCard || userChangedTocState) {
			return;
		}

		syncingTocState = true;
		tocCard.open = !mobileTocQuery.matches;
		window.setTimeout(() => {
			syncingTocState = false;
		}, 0);
	};

	const queueActiveTocUpdate = () => {
		if (tocAnimationFrame) {
			return;
		}

		tocAnimationFrame = window.requestAnimationFrame(() => {
			tocAnimationFrame = 0;
			updateActiveTocLink();
		});
	};

	articleBody?.querySelectorAll('pre').forEach((pre) => {
		const code = pre.querySelector('code');

		if (!code) {
			return;
		}

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'copy-code-btn';
		button.textContent = '复制代码';

		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(code.textContent ?? '');
			button.textContent = '已复制';

			window.setTimeout(() => {
				button.textContent = '复制代码';
			}, 1200);
		});

		pre.appendChild(button);
	});

	backToTopButton?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
	});

	for (const { link, target } of tocTargets) {
		link.addEventListener('click', (event) => {
			event.preventDefault();
			if (mobileTocQuery.matches && tocCard) {
				tocCard.open = false;
			}
			lockTocToTarget(link, target);
		});
	}

	tocCard?.addEventListener('toggle', () => {
		if (syncingTocState) {
			return;
		}

		userChangedTocState = true;
	});

	mobileTocQuery.addEventListener('change', () => {
		userChangedTocState = false;
		syncTocStateForViewport();
	});

	syncTocStateForViewport();

	if (tocTargets.length > 0) {
		updateActiveTocLink();
		window.addEventListener('scroll', queueActiveTocUpdate, { passive: true });
		window.addEventListener('resize', queueActiveTocUpdate);
	}
</script>

<style>
	.article-shell {
		position: relative;
		container: article-shell / inline-size;
		display: grid;
		gap: clamp(20px, 2.7vw, 30px);
	}

	.article-shell :where(.article-header, .toc-card, .article-body) {
		border: 1px solid var(--line);
		border-radius: var(--radius-panel);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel) 90%, var(--bg));
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
		box-sizing: border-box;
		overflow: clip;
	}

	.article-header,
	.article-copy,
	.article-meta,
	.meta-index-item,
	.article-body {
		display: grid;
	}

	.article-header {
		gap: 22px;
		padding: clamp(26px, 3.5vw, 34px);
	}

	.article-heading {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(15rem, 0.72fr);
		align-items: start;
		gap: 28px;
	}

	.article-copy {
		gap: 14px;
		max-width: 46rem;
	}

	.back-link,
	.toc-count,
	.back-to-top,
		:global(.copy-code-btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-pill);
		font: inherit;
	}

	.back-link {
		justify-self: start;
		min-height: 30px;
		padding: 6px 11px;
		border: 1px solid rgba(153, 176, 255, 0.16);
		background: rgba(255, 255, 255, 0.035);
		color: var(--text-soft);
		font-size: 0.86rem;
		text-decoration: none;
		transition:
			transform 0.18s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.back-link:is(:hover, :focus-visible) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background: rgba(157, 140, 255, 0.12);
		color: var(--text);
	}

	.back-link:focus-visible,
	.toc-card a:focus-visible,
	.back-to-top:focus-visible,
		:global(.copy-code-btn:focus-visible) {
		outline: var(--focus-ring);
		outline-offset: var(--focus-offset);
	}

	.kicker,
	.meta-label {
		margin: 0;
		text-transform: uppercase;
	}

	.kicker {
		font-size: 0.82rem;
		letter-spacing: 0.14em;
		color: var(--accent-soft);
	}

	.meta-label {
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		color: var(--text-soft);
	}

	:is(h1, h2, p, ul, strong, time, span) {
		margin-top: 0;
		overflow-wrap: anywhere;
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: 1.08;
	}

	.article-description {
		margin: 0;
		max-width: 44rem;
		line-height: 1.82;
		color: var(--text-soft);
	}

	.article-meta {
		grid-template-columns: 1fr;
		gap: 10px;
		align-content: start;
		padding-left: 20px;
		border-left: 1px solid rgba(153, 176, 255, 0.12);
	}

	.meta-index-item {
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 12px;
		min-height: 72px;
		padding: 14px 16px;
		border: 1px solid rgba(153, 176, 255, 0.14);
		border-radius: 20px;
		background: color-mix(in srgb, var(--panel-strong) 78%, var(--bg));
	}

	.meta-index-item.muted {
		background: color-mix(in srgb, var(--panel) 92%, var(--bg));
	}

	.meta-index-item strong,
	.meta-index-item time {
		justify-self: end;
		text-align: right;
		font-size: 1rem;
		line-height: 1.35;
		color: var(--text);
	}

	.article-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 18px;
		align-items: start;
	}

	.toc-card {
		padding: 22px 22px 18px;
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.016), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel) 94%, var(--bg));
	}

	.toc-card summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 0;
		padding-bottom: 14px;
		border-bottom: 1px solid rgba(153, 176, 255, 0.1);
		font-size: 0.98rem;
		font-weight: 700;
		cursor: pointer;
		list-style: none;
	}

	.toc-card summary::-webkit-details-marker {
		display: none;
	}

	.toc-card summary::after {
		content: '⌄';
		display: none;
		color: var(--text-soft);
		transition: transform 160ms ease;
	}

	.toc-card[open] summary::after {
		transform: rotate(180deg);
	}

	.toc-count {
		padding: 4px 8px;
		border: 1px solid rgba(153, 176, 255, 0.14);
		background: rgba(255, 255, 255, 0.035);
		color: var(--text-soft);
		font-size: 0.78rem;
	}

	.toc-panel {
		padding-top: 8px;
		overflow: visible;
	}

	.toc-card ul {
		margin-bottom: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0;
	}

	.toc-card ul::before {
		content: none;
	}

	.toc-card li {
		padding: 0;
		border-top: 1px solid rgba(153, 176, 255, 0.1);
	}

	.toc-card li:first-child {
		border-top: 0;
	}

	.toc-card li::before {
		content: none;
	}

	.toc-card li::after {
		content: none;
	}

	.toc-card li.nested {
		margin-left: 12px;
		padding-left: 12px;
		border-left: 1px solid rgba(153, 176, 255, 0.14);
	}

	.toc-card li.nested::after {
		content: none;
	}

	.toc-card a {
		display: block;
		padding: 10px 12px;
		border-radius: 14px;
		color: var(--text-soft);
		text-decoration: none;
		transition:
			background 160ms ease,
			color 160ms ease;
	}

	.toc-card a:is(:hover, .is-active) {
		background: rgba(255, 255, 255, 0.04);
		color: var(--text);
	}

	.toc-card a.is-active {
		box-shadow: inset 0 0 0 1px rgba(153, 176, 255, 0.12);
	}

	@container article-shell (min-width: 60rem) {
		.article-grid.has-toc {
			grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
			gap: 20px;
		}

		.article-grid.has-toc .toc-card {
			position: sticky;
			top: 20px;
		}
	}

	.article-body {
		padding: clamp(28px, 3.8vw, 40px);
		font-size: 1.03rem;
		line-height: 1.9;
		color: var(--text);
		background:
			linear-gradient(180deg, rgba(255, 255, 255, 0.014), rgba(255, 255, 255, 0)),
			color-mix(in srgb, var(--panel-strong) 86%, var(--bg));
		box-shadow:
			0 12px 28px rgba(0, 0, 0, 0.18),
			inset 0 1px 0 rgba(255, 255, 255, 0.02);
	}

	.article-body :global(h2),
	.article-body :global(h3) {
		line-height: 1.22;
		scroll-margin-top: 28px;
	}

	.article-body :global(h2) {
		margin: 40px 0 14px;
		font-size: clamp(1.45rem, 3vw, 1.92rem);
	}

	.article-body :global(h3) {
		margin: 30px 0 12px;
		font-size: clamp(1.18rem, 2.2vw, 1.4rem);
	}

	.article-body :global(p),
	.article-body :global(ul),
	.article-body :global(ol),
	.article-body :global(pre),
	.article-body :global(blockquote) {
		margin: 0 0 18px;
	}

	.article-body :global(ul),
	.article-body :global(ol) {
		padding-left: 1.4rem;
	}

	.article-body :global(li) {
		margin-bottom: 10px;
		color: var(--text-soft);
	}

	.article-body :global(strong) {
		color: var(--text);
	}

	.article-body :global(a) {
		color: var(--accent-soft);
		text-decoration-color: rgba(110, 195, 255, 0.36);
		text-underline-offset: 0.18em;
	}

	.article-body :global(blockquote) {
		padding: 18px 20px;
		border-left: 3px solid rgba(153, 176, 255, 0.28);
		border-radius: 18px;
		background: color-mix(in srgb, var(--panel) 90%, var(--bg));
		color: var(--text);
	}

	.article-body :global(code) {
		padding: 2px 7px;
		border-radius: 8px;
		background: rgba(153, 176, 255, 0.08);
		color: #f3f6ff;
		font-size: 0.94em;
	}

	.article-body :global(pre) {
		position: relative;
		padding: 20px;
		border: 1px solid rgba(153, 176, 255, 0.14);
		border-radius: 20px;
		background: color-mix(in srgb, var(--panel-strong) 82%, var(--bg));
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
		overflow-x: auto;
	}

	.article-body :global(pre code) {
		padding: 0;
		border-radius: 0;
		background: transparent;
		font-size: 0.95rem;
		line-height: 1.8;
	}

	.back-to-top,
	:global(.copy-code-btn) {
		border: 1px solid rgba(153, 176, 255, 0.16);
		background: rgba(255, 255, 255, 0.035);
		color: var(--text-soft);
		cursor: pointer;
		transition:
			transform 0.18s ease,
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
	}

	.back-to-top:is(:hover, :focus-visible),
	:global(.copy-code-btn:is(:hover, :focus-visible)) {
		transform: translateY(-1px);
		border-color: var(--hover-border);
		background: rgba(157, 140, 255, 0.12);
		color: var(--text);
	}

	.back-to-top {
		justify-self: end;
		padding: 10px 16px;
	}

	:global(.copy-code-btn) {
		position: absolute;
		top: 14px;
		right: 14px;
		padding: 7px 12px;
	}

	@media (max-width: 720px) {
		.article-shell {
			gap: 14px;
		}

		.article-shell :where(.article-header, .article-body) {
			padding: 22px;
		}

		.article-heading,
		.article-meta {
			grid-template-columns: 1fr;
		}

		.article-meta {
			padding-left: 0;
			padding-top: 10px;
			border-left: 0;
			border-top: 1px solid rgba(153, 176, 255, 0.12);
		}

		.meta-index-item {
			grid-template-columns: 1fr;
		}

		.meta-index-item strong,
		.meta-index-item time {
			justify-self: start;
			text-align: left;
		}

		.toc-card {
			padding: 0;
			overflow: hidden;
		}

		.toc-card summary {
			margin-bottom: 0;
			padding: 16px 22px;
		}

		.toc-card summary::after {
			display: inline-block;
		}

		.toc-panel {
			max-height: 240px;
			padding: 8px 20px 16px;
			overflow: auto;
			-webkit-overflow-scrolling: touch;
		}

		.article-body {
			font-size: 1.01rem;
			line-height: 1.88;
			overflow-wrap: anywhere;
		}

		.article-body :global(h2) {
			margin-top: 34px;
		}

		.article-body :global(h3) {
			margin-top: 26px;
		}
	}
</style>
