---
import Layout from './Layout.astro';
import { withBase } from '../utils/paths';

interface Props {
	frontmatter: {
		title: string;
		description: string;
	};
}

const { title, description } = Astro.props.frontmatter;
const base = import.meta.env.BASE_URL;
---

<Layout title={`${title} | Dead Soul Insects`} description={description}>
	<article class="origin-detail">
		<header class="origin-detail-heading">
			<a class="origin-back" href={withBase(base, '/origin/')}>
				<span aria-hidden="true">←</span> 返回起源
			</a>
			<h1>{title}</h1>
		</header>
		<div class="origin-detail-body">
			<slot />
		</div>
	</article>
</Layout>

<style>
	.origin-detail {
		inline-size: min(100%, var(--reading-measure));
		margin-inline: auto;
		overflow-wrap: anywhere;
	}

	.origin-back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-block-size: 2.75rem;
		color: var(--text-soft);
		font-size: var(--text-note);
		line-height: 1.6;
		text-underline-offset: var(--space-1);
	}

	.origin-back:is(:hover, :focus-visible) {
		color: var(--accent-soft);
	}

	.origin-detail-heading {
		margin-block-end: var(--space-7);
	}

	.origin-detail-heading h1 {
		margin: var(--space-5) 0 0;
		font-family: var(--font-reading);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 500;
		line-height: 1.3;
		text-wrap: balance;
	}

	.origin-detail-body {
		inline-size: min(100%, var(--article-reading-measure));
		margin-inline: auto;
		font-size: var(--article-body-size);
		font-weight: 400;
		line-height: var(--article-body-line);
		color: var(--text);
	}

	.origin-detail-body :global(h2),
	.origin-detail-body :global(h3),
	.origin-detail-body :global(p),
	.origin-detail-body :global(ul),
	.origin-detail-body :global(ol),
	.origin-detail-body :global(pre),
	.origin-detail-body :global(blockquote) {
		margin-top: 0;
	}

	.origin-detail-body :global(h2),
	.origin-detail-body :global(h3) {
		margin: var(--space-7) 0 var(--space-4);
		font-family: var(--font-reading);
		font-weight: 500;
		line-height: 1.4;
	}

	.origin-detail-body :global(h2) {
		font-size: var(--text-row);
	}

	.origin-detail-body :global(h3) {
		font-family: var(--font-ui);
		font-weight: 600;
		font-size: 1.25rem;
	}

	.origin-detail-body :global(> :first-child) {
		margin-block-start: 0;
	}

	.origin-detail-body :global(p),
	.origin-detail-body :global(ul),
	.origin-detail-body :global(ol),
	.origin-detail-body :global(pre),
	.origin-detail-body :global(blockquote) {
		margin-bottom: var(--space-5);
	}

	.origin-detail-body :global(a) {
		color: var(--accent-soft);
		text-decoration-color: currentColor;
		text-underline-offset: 0.18em;
	}

	.origin-detail-body :global(a:is(:hover, :focus-visible)) {
		color: var(--text);
	}

	@media (max-width: 760px) {
		.origin-detail-heading {
			margin-block-end: var(--space-6);
		}
	}
</style>
