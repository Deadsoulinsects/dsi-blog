<dialog class="article-lightbox" data-lightbox aria-labelledby="lightbox-title" aria-describedby="lightbox-help">
	<div class="lightbox-surface">
		<header class="lightbox-toolbar">
			<h2 id="lightbox-title">图片预览</h2>
			<span class="lightbox-counter" data-lightbox-counter aria-live="polite"></span>
			<button type="button" data-lightbox-reset aria-label="恢复图片到适合窗口的大小">
				<span data-lightbox-zoom>100%</span>
				<span>恢复</span>
			</button>
			<button type="button" data-lightbox-close aria-label="关闭图片预览">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg>
			</button>
		</header>
		<div class="lightbox-view">
			<button class="lightbox-step" type="button" data-lightbox-previous aria-label="上一张图片">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg>
			</button>
			<div class="lightbox-stage" data-lightbox-stage>
				<img class="lightbox-image" data-lightbox-image alt="" draggable="false" hidden />
				<p class="lightbox-status" data-lightbox-status role="status"></p>
			</div>
			<button class="lightbox-step" type="button" data-lightbox-next aria-label="下一张图片">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
			</button>
		</div>
		<footer class="lightbox-footer">
			<p class="lightbox-caption" data-lightbox-caption></p>
			<p id="lightbox-help">滚轮缩放 · 放大后拖动查看 · 双击恢复 · Esc 退出</p>
		</footer>
	</div>
</dialog>

<script>
	import { mountArticleLightbox } from '../shared/media/lightbox';

	const mount = () => {
		const root = document.querySelector<HTMLElement>('.article-prose');
		const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
		if (!root || !dialog) return;
		const dispose = mountArticleLightbox(root, dialog);
		window.addEventListener('pagehide', dispose, { once: true });
	};
	mount();
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) mount();
	});
</script>

<style is:global>
